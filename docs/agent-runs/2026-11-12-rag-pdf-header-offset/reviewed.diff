+def has_pdf_header(data: bytes) -> bool:
+    """%PDF- が、先頭から PDF_HEADER_OFFSET_LIMIT バイト目までのどこかで始まっていれば True。"""
+    return data.find(b"%PDF-", 0, PDF_HEADER_OFFSET_LIMIT + len(b"%PDF-")) != -1
