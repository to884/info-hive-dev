+"""同梱のスクリプトの Python の版の扱い（Python 3.12 以上を対象にする。wiki 0.11.0、ADR-0018）の試験。
+
+- 標準ライブラリだけのスクリプトは、利用者の python で直接動くので、どれも最初に読み込む wiki_text.py で版を確かめ、
+  古い版では理由を書いて止まる。古い版の Python を真似て（sys.version_info を差し替えて）読み込み、止まることを確かめる。
+- 古い版でも版の確かめまで届くよう、wiki_text.py と、直接動かす入口のスクリプトが、3.10 の構文で読めること、
+  ほかの wiki のモジュールより先に wiki_text を読み込むことを確かめる。
+- uv で動かすスクリプトの PEP 723 の宣言が、どれも 3.12 以上を求めること。
+
+実行（標準ライブラリだけで動く）:
+    python -X utf8 -B -m unittest tests/wiki/test_python_version.py -v
+"""
+from __future__ import annotations
+
+import ast
+import re
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+SCRIPTS = ROOT / "info-hive-wiki/skills/info-hive/scripts"
+
+# コマンドとスキルの手順が `python "<スクリプト>"` で直接動かすもの
+DIRECT = ("wiki_lint.py", "wiki_stats.py", "wiki_search.py", "wiki_graph_query.py", "init_wiki.py", "wiki_help.py",
+          "wiki_fetch.py", "wiki_encoding.py")
+
+
+class GuardTests(unittest.TestCase):
+    def run_with_version(self, version):
+        code = (f"import sys; sys.version_info = {version!r}; sys.path.insert(0, {str(SCRIPTS)!r}); "
+                "import wiki_text; print('読み込めた')")
+        return subprocess.run([sys.executable, "-X", "utf8", "-B", "-c", code], capture_output=True,
+                              encoding="utf-8", errors="replace")
+
+    def test_old_python_stops_with_a_reason(self):
+        for version in ((3, 11, 9, "final", 0), (3, 10, 11, "final", 0)):
+            with self.subTest(version=version[:2]):
+                done = self.run_with_version(version)
+                self.assertEqual(done.returncode, 1, done.stderr)
+                self.assertIn("Python 3.12 以上が必要である", done.stderr)
+                self.assertNotIn("読み込めた", done.stdout)
+
+    def test_supported_python_passes(self):
+        done = self.run_with_version((3, 12, 0, "final", 0))
+        self.assertEqual(done.returncode, 0, done.stderr)
+        self.assertIn("読み込めた", done.stdout)
+
+
+class SourceTests(unittest.TestCase):
+    def test_entry_scripts_reach_the_guard(self):
+        """wiki_text.py と入口のスクリプトが 3.10 の構文で読め、ほかの wiki のモジュールより先に wiki_text を読み込む。"""
+        for name in ("wiki_text.py",) + DIRECT:
+            with self.subTest(script=name):
+                source = (SCRIPTS / name).read_text(encoding="utf-8")
+                tree = ast.parse(source, feature_version=(3, 10))
+                if name == "wiki_text.py":
+                    continue
+                first = None
+                for node in ast.walk(tree):
+                    if isinstance(node, ast.Import):
+                        names = [alias.name for alias in node.names if alias.name.startswith("wiki_")]
+                    elif isinstance(node, ast.ImportFrom) and node.module and node.module.startswith("wiki_"):
+                        names = [node.module]
+                    else:
+                        continue
+                    if names and (first is None or node.lineno < first[0]):
+                        first = (node.lineno, names[0])
+                self.assertIsNotNone(first, f"{name} が wiki のモジュールを読み込んでいない")
+                self.assertEqual(first[1], "wiki_text", f"{name} は、wiki_text より先に {first[1]} を読み込む")
+
+    def test_pep723_headers_require_312(self):
+        pattern = re.compile(r'^# requires-python = "(.+)"$', re.MULTILINE)
+        found = {}
+        for path in sorted(SCRIPTS.glob("*.py")):
+            source = path.read_text(encoding="utf-8")
+            if "# /// script" not in source:
+                continue
+            match = pattern.search(source)
+            found[path.name] = match.group(1) if match else None
+        self.assertGreaterEqual(len(found), 8)
+        self.assertEqual({name: value for name, value in found.items() if value != ">=3.12"}, {})
+
+
+if __name__ == "__main__":
+    unittest.main()
