+def link_warnings(*walks) -> list:
+    """走査の結果の links を、結果の欄 link_warnings の形（{"path", "kind"} の並び）にする。重ねて出さない。"""
+    seen, out = set(), []
+    for walk in walks:
+        for rel, kind in getattr(walk, "links", ()) or ():
+            if rel not in seen:
+                seen.add(rel)
+                out.append({"path": rel, "kind": kind})
+    return out
 
 
