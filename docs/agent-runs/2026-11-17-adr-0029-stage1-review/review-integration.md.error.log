{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011GhxVDrnJU4gB5DouiMm1w","type":"tool_result","content":"590\tclass ReviewFiveTests(Base):\n591\t    \"\"\"第5回の反例を、実ファイルと入口の実行で検査する。\"\"\"\n592\t\n593\t    def setUp(self):\n594\t        super().setUp()\n595\t        self.skill = self.ext / \"skill\"\n596\t        self.skill.mkdir()\n597\t        (self.skill / \"SKILL.md\").write_text(\"before\", encoding=\"utf-8\")\n598\t        self.state = self.wiki / \".evolution\"\n599\t        self.state.mkdir()\n600\t        self.write(\"concepts/evidence.md\", page(\"evidence\"))\n601\t\n602\t    def args(self, candidate, **values):\n603\t        return SimpleNamespace(**dict(dict(id=\"sample\", skill=self.skill, candidate=candidate,\n604\t                                          target=\"SKILL.md\", wiki=self.wiki, reason=\"回帰の確認\",\n605\t                                          evidence=[\"concepts/evidence.md\"]), **values))\n606\t\n607\t    def record_reads(self, reads):\n608\t        original = Path.read_bytes\n609\t        def read(path):\n610\t            reads.append(path)\n611\t            return original(path)\n612\t        return mock.patch.object(Path, \"read_bytes\", read)\n613\t\n614\t    def directory_case(self):\n615\t        directory = self.wiki / \"concepts/candidate\"\n616\t        directory.mkdir()\n617\t        (directory / \"SKILL.md\").write_text(\"after\", encoding=\"utf-8\")\n618\t        linked = directory / \"p.md\"\n619\t        linked.write_text(\"refused\", encoding=\"utf-8\")\n620\t        os.link(linked, self.ext / \"copy.md\")\n621\t        return directory, linked\n622\t\n623\t    def assert_directory_refused(self, directory, linked):\n624\t        import wiki_evolve\n625\t        reads = []\n626\t        with self.record_reads(reads), wiki_pages.capture_notices() as notices:\n627\t            with self.assertRaisesRegex(ValueError, \"リンク\"):\n628\t                wiki_evolve.propose(self.args(directory, target=None), self.state)\n629\t        self.assertNotIn(linked, reads, \"拒むべき記事の本文を読んだ\")\n630\t        self.assertIn({\"path\": \"concepts/candidate/p.md\", \"kind\": \"hardlink\"}, notices.items)\n631\t        self.assertFalse((self.state / \"sample\").exists())\n632\t\n633\t    def test_directory_candidate_refuses_before_reading(self):\n634\t        self.assert_directory_refused(*self.directory_case())\n635\t\n636\t    def test_regression_catches_tree_that_drops_the_wiki(self):\n637\t        \"\"\"読む口の呼び出し名が残っていても、wiki の引き渡しを欠く実装を検出する。\"\"\"\n638\t        import wiki_evolve\n639\t        directory, linked = self.directory_case()\n640\t        original = wiki_evolve.tree\n641\t        with mock.patch.object(wiki_evolve, \"tree\", side_effect=lambda root, wiki_root=None: original(root)):\n642\t            with self.assertRaises(AssertionError):\n643\t                self.assert_directory_refused(directory, linked)\n644\t\n645\t    def test_installed_skill_under_wiki_is_also_checked(self):\n646\t        import wiki_evolve\n647\t        source, linked = self.directory_case()\n648\t        candidate = self.write(\"candidate.md\", \"after\", self.ext)\n649\t        reads = []\n650\t        with self.record_reads(reads):\n651\t            with self.assertRaisesRegex(ValueError, \"リンク\"):\n652\t                wiki_evolve.propose(self.args(candidate, skill=source), self.state)\n653\t        self.assertNotIn(linked, reads)\n654\t\n655\t    def test_single_candidates_preserve_bytes_and_article_scope(self):\n656\t        import wiki_evolve\n657\t        data = b\"after\\r\\nwith CRLF\\r\\n\"\n658\t        cases = [(self.ext, \"outside.md\"), (self.wiki, \"concepts/candidate.md\"),\n659\t                 (self.wiki, \"assets/candidate.md\"), (self.wiki, \"candidate.txt\"),\n660\t                 (self.wiki, \".hidden/candidate.md\")]\n661\t        for number, (root, name) in enumerate(cases):\n662\t            with self.subTest(path=name):\n663\t                path = root / name\n664\t                path.parent.mkdir(parents=True, exist_ok=True)\n665\t                path.write_bytes(data)\n666\t                result = wiki_evolve.propose(self.args(path, id=f\"case-{number}\"), self.state)\n667\t                self.assertEqual(result[\"status\"], \"proposed\")\n668\t                self.assertEqual((self.state / f\"case-{number}/candidate/SKILL.md\").read_bytes(), data)\n669\t\n670\t    def test_single_linked_article_is_not_read(self):\n671\t        import wiki_evolve\n672\t        linked = self.write(\"concepts/candidate.md\", \"refused\")\n673\t        os.link(linked, self.ext / \"copy.md\")\n674\t        reads = []\n675\t        with self.record_reads(reads):\n676\t            with self.assertRaisesRegex(ValueError, \"リンク\"):\n677\t                wiki_evolve.propose(self.args(linked), self.state)\n678\t        self.assertNotIn(linked, reads)\n679\t\n680\t    def proposal(self):\n681\t        import wiki_evolve\n682\t        candidate = self.write(\"candidate.md\", \"after\", self.ext)\n683\t        wiki_evolve.propose(self.args(candidate), self.state)\n684\t        return self.state / \"sample\"\n685\t\n686\t    def test_evaluate_refuses_original_corpus_before_reading(self):\n687\t        import wiki_evolve\n688\t        exp = self.proposal()\n689\t        linked = self.write(\"concepts/p.md\", \"refused\")\n690\t        os.link(linked, self.ext / \"copy.md\")\n691\t        suite = self.tmp / \"suite.json\"\n692\t        suite.write_text(json.dumps({\"corpus\": \"wiki\"}), encoding=\"utf-8\")\n693\t        reads = []\n694\t        with self.record_reads(reads), mock.patch.object(wiki_evolve, \"suite_contract\") as contract:\n695\t            with self.assertRaisesRegex(ValueError, \"リンク\"):\n696\t                wiki_evolve.evaluate(SimpleNamespace(suite=suite, wiki=self.wiki), exp)\n697\t        contract.assert_not_called()\n698\t        self.assertNotIn(linked, reads)\n699\t        self.assertFalse(list(exp.glob(\"inputs-*.json\")))\n700\t\n701\t    def test_nonarticle_hardlink_is_allowed_in_corpus_and_copy(self):\n702\t        import wiki_evolve\n703\t        import wiki_evolve_loop as loop\n704\t        path = self.write(\"assets/image.dat\", \"asset\")\n705\t        os.link(path, self.ext / \"copy.dat\")\n706\t        wiki_evolve.tree(self.wiki, self.wiki)\n707\t        dest = self.ext / \"snapshot\"\n708\t        wiki_evolve.copy_tree(self.wiki, dest, self.wiki)\n709\t        self.assertEqual((dest / \"assets/image.dat\").read_text(encoding=\"utf-8\"), \"asset\")\n710\t        suite = self.tmp / \"suite.json\"\n711\t        suite.write_text(json.dumps({\"corpus\": \"wiki\"}), encoding=\"utf-8\")\n712\t        args = SimpleNamespace(id=\"run\", skill=self.skill, wiki=self.wiki, suite=suite)\n713\t        class ReachedContract(Exception):\n714\t            pass\n715\t        with mock.patch.object(loop, \"contract\", side_effect=ReachedContract):\n716\t            with self.assertRaises(ReachedContract):\n717\t                loop.run(args, self.state)\n718\t\n719\t    def test_parent_segments_are_rejected_before_reading_or_normalizing(self):\n720\t        paths = [self.wiki / \"concepts/jump/../candidate.md\", self.ext / \"../candidate.md\"]\n721\t        for path in paths:\n722\t            for reader in (wiki_pages.read_user_file, wiki_pages.read_user_bytes):\n723\t                with self.subTest(path=str(path), reader=reader.__name__):\n724\t                    with mock.patch.object(os.path, \"abspath\", side_effect=AssertionError(\"正規化してはいけない\")):\n725\t                        with self.assertRaisesRegex(ValueError, r\"\\.\\.\"):\n726\t                            reader(path, self.wiki)\n727\t\n728\t    def test_parent_segments_in_propose_are_rejected(self):\n729\t        import wiki_evolve\n730\t        candidate = self.wiki / \"concepts/jump/../candidate.md\"\n731\t        with self.assertRaisesRegex(ValueError, r\"\\.\\.\"):\n732\t            wiki_evolve.propose(self.args(candidate), self.state)\n733\t\n734\t    @unittest.skipIf(NT, \"POSIX のシンボリックリンクと .. の解決を使う\")\n735\t    def test_posix_parent_after_symlink_never_reads_a_decoy(self):\n736\t        import wiki_evolve\n737\t        (self.wiki / \"other/deep\").mkdir(parents=True)\n738\t        os.symlink(self.wiki / \"other/deep\", self.wiki / \"concepts/jump\", target_is_directory=True)\n739\t        self.write(\"concepts/candidate.md\", \"decoy\")\n740\t        linked = self.write(\"other/candidate.md\", \"refused\")\n741\t        os.link(linked, self.ext / \"copy.md\")\n742\t        candidate = self.wiki / \"concepts/jump/../candidate.md\"\n743\t        for reader in (wiki_pages.read_user_file, wiki_pages.read_user_bytes):\n744\t            with self.assertRaisesRegex(ValueError, r\"\\.\\.\"):\n745\t                reader(candidate, self.wiki)\n746\t        with self.assertRaisesRegex(ValueError, r\"\\.\\.\"):\n747\t            wiki_evolve.propose(self.args(candidate), self.state)\n748\t\n749\t\n750\t    def test_cli_keeps_protection_through_root_alias_and_outgoing_junction(self):\n751\t        outside = self.write(\"p.md\", \"refused\", self.ext)\n752\t        view = self.tmp / \"view\"\n753\t        if not junction(view, self.wiki) or not junction(self.wiki / \"concepts/jump\", self.ext):\n754\t            self.skipTest(\"ディレクトリのリンクを作れない\")\n755\t        alias = view / \"concepts/jump/p.md\"\n756\t        for reader in (wiki_pages.read_user_file, wiki_pages.read_user_bytes):\n757\t            with wiki_pages.capture_notices() as notices:\n758\t                with self.assertRaisesRegex(ValueError, \"リンク\"):\n759\t                    reader(alias, self.wiki)\n760\t            self.assertTrue(notices.items)\n761\t        done = subprocess.run([sys.executable, \"-X\", \"utf8\", \"-B\", str(SCRIPTS / \"wiki_evolve.py\"),\n762\t                               \"--wiki\", str(view), \"propose\", \"--id\", \"alias\", \"--skill\", str(self.skill),\n763\t                               \"--candidate\", str(alias), \"--target\", \"SKILL.md\", \"--reason\", \"回帰\",\n764\t                               \"--evidence\", \"concepts/evidence.md\"],\n765\t                              capture_output=True, encoding=\"utf-8\", timeout=20)\n766\t        self.assertEqual(done.returncode, 1, done.stdout + done.stderr)\n767\t        self.assertIn(\"リンク\", done.stderr)\n768\t        self.assertFalse((self.state / \"alias\").exists())\n769\t        self.assertEqual(outside.read_text(encoding=\"utf-8\"), \"refused\")\n770\t\n771\t    def nested_corpus(self, prefix=\"concepts\"):\n772\t        corpus = self.wiki / prefix / \"corpus\"\n773\t        linked = self.write(f\"{prefix}/corpus/assets/p.md\", \"refused\")\n774\t        os.link(linked, self.ext / \"copy.md\")\n775\t        suite = corpus.parent / \"suite.json\"\n776\t        suite.write_text(json.dumps({\"corpus\": \"corpus\"}), encoding=\"utf-8\")\n777\t        return corpus, linked, suite\n778\t\n779\t    def assert_nested_loop_refused(self, linked, suite):\n780\t        import wiki_evolve_loop as loop\n781\t        class ReachedContract(Exception):\n782\t            pass\n783\t        args = SimpleNamespace(id=\"run\", wiki=self.wiki, skill=self.skill, suite=suite)\n784\t        reads = []\n785\t        with self.record_reads(reads), mock.patch.object(loop, \"contract\", side_effect=ReachedContract) as contract:\n786\t            with wiki_pages.capture_notices() as notices:\n787\t                try:\n788\t                    loop.run(args, self.state)\n789\t                except ValueError as exc:\n790\t                    self.assertIn(\"リンク\", str(exc))\n791\t                except ReachedContract:\n792\t                    self.fail(\"リンクの記事を拒否せず contract に進んだ\")\n793\t                else:\n794\t                    self.fail(\"リンクの記事を拒否しなかった\")\n795\t        contract.assert_not_called()\n796\t        self.assertNotIn(linked, reads)\n797\t        self.assertTrue(notices.items)\n798\t\n799\t    def test_nested_corpus_uses_the_original_wiki_in_both_entries(self):\n800\t        import wiki_evolve\n801\t        exp = self.proposal()\n802\t        corpus, linked, suite = self.nested_corpus()\n803\t        self.assertEqual(wiki_pages.source_wiki_root(corpus, self.wiki), self.wiki)\n804\t        self.assert_nested_loop_refused(linked, suite)\n805\t        reads = []\n806\t        with self.record_reads(reads), mock.patch.object(wiki_evolve, \"suite_contract\") as contract:\n807\t            with self.assertRaisesRegex(ValueError, \"リンク\"):\n808\t                wiki_evolve.evaluate(SimpleNamespace(wiki=self.wiki, suite=suite), exp)\n809\t        contract.assert_not_called()\n810\t        self.assertNotIn(linked, reads)\n811\t\n812\t    def test_regression_catches_a_wrong_corpus_root(self):\n813\t        corpus, linked, suite = self.nested_corpus()\n814\t        with mock.patch.object(wiki_pages, \"source_wiki_root\", side_effect=lambda path, wiki=None: path):\n815\t            with self.assertRaises(AssertionError):\n816\t                self.assert_nested_loop_refused(linked, suite)\n817\t\n818\t    def test_corpus_in_excluded_tree_does_not_create_new_articles(self):\n819\t        import wiki_evolve\n820\t        corpus, linked, suite = self.nested_corpus(prefix=\"assets\")\n821\t        root = wiki_pages.source_wiki_root(corpus, self.wiki)\n822\t        self.assertEqual(root, self.wiki)\n823\t        target = self.ext / \"snapshot\"\n824\t        wiki_evolve.copy_tree(corpus, target, root)\n825\t        self.assertEqual((target / \"assets/p.md\").read_text(encoding=\"utf-8\"), \"refused\")\n826\t        self.assertEqual(wiki_pages.article_path(self.wiki, \"assets/corpus/assets/p.md\").state, \"not_article\")\n827\t\n828\t    def test_linked_directory_is_rejected_before_walking(self):\n829\t        import wiki_evolve\n830\t        jump = self.wiki / \"concepts/jump\"\n831\t        if not junction(jump, self.ext):\n832\t            self.skipTest(\"ディレクトリのリンクを作れない\")\n833\t        with mock.patch.object(wiki_evolve.os, \"walk\", side_effect=AssertionError(\"リンクに降りてはいけない\")):\n834\t            with self.assertRaisesRegex(ValueError, \"リンク\"):\n835\t                wiki_evolve.tree(jump, self.wiki)\n836\t\n837\t    def test_posix_colon_reaches_the_same_link_check_as_other_articles(self):\n838\t        import stat\n839\t        def attributes(path):\n840\t            return \"ok\", SimpleNamespace(st_mode=stat.S_IFREG if str(path).endswith(\"a:b.md\") else stat.S_IFDIR,\n841\t                                          st_nlink=2 if str(path).endswith(\"a:b.md\") else 1)\n842\t        with mock.patch.object(wiki_pages, \"NT\", False), mock.patch.object(wiki_pages, \"_stat_entry\", side_effect=attributes) as lookup:\n843\t            for reader in (wiki_pages.read_user_file, wiki_pages.read_user_bytes):\n844\t                with self.assertRaisesRegex(ValueError, \"リンク\"):\n845\t                    reader(self.wiki / \"concepts/a:b.md\", self.wiki)\n846\t        self.assertGreater(lookup.call_count, 0)\n847\t\n848\t    @unittest.skipIf(NT, \"POSIX のファイル名の : を使う\")\n849\t    def test_posix_colon_hardlink_is_not_read(self):\n850\t        linked = self.write(\"concepts/a:b.md\", \"refused\")\n851\t        os.link(linked, self.ext / \"copy.md\")\n852\t        with self.assertRaisesRegex(ValueError, \"リンク\"):\n853\t            wiki_pages.read_user_bytes(linked, self.wiki)\n854\t\n855\t    def test_case_conversion_does_not_change_relative_path_offsets(self):\n856\t        root = self.tmp / \"W\\u0130\"\n857\t        found = wiki_pages._article_rel(root / \"concepts/p.md\", root)\n858\t        self.assertEqual(found, (str(root), \"concepts/p.md\"))\n859\t\n860\t    def test_unlistable_root_and_subdirectory_never_become_empty_snapshots(self):\n861\t        import wiki_evolve\n862\t        root = self.ext / \"input\"\n863\t        (root / \"sub\").mkdir(parents=True)\n864\t        (root / \"sub/p.md\").write_text(\"data\", encoding=\"utf-8\")\n865\t        scan = os.scandir\n866\t        for blocked in (root, root / \"sub\"):\n867\t            def denied(path):\n868\t                if Path(path) == blocked:\n869\t                    raise PermissionError(13, \"denied\", str(blocked))\n870\t                return scan(path)\n871\t            for copy in (False, True):\n872\t                with self.subTest(blocked=str(blocked), copy=copy):\n873\t                    dest = self.ext / \"snapshot\"\n874\t                    with mock.patch.object(os, \"scandir\", side_effect=denied):\n875\t                        with self.assertRaises(PermissionError) as error:\n876\t                            if copy:\n877\t                                wiki_evolve.copy_tree(root, dest, root)\n878\t                            else:\n879\t                                wiki_evolve.tree(root, root)\n880\t                    self.assertEqual(error.exception.filename, str(blocked))\n881\t                    self.assertFalse(dest.exists())\n882\t\n883\t    def test_both_corpus_entries_stop_before_contract_on_listing_error(self):\n884\t        import wiki_evolve\n885\t        import wiki_evolve_loop as loop\n886\t        exp = self.proposal()\n887\t        corpus = self.wiki / \"concepts/corpus\"\n888\t        corpus.mkdir()\n889\t        suite = self.tmp / \"suite.json\"\n890\t        suite.write_text(json.dumps({\"corpus\": \"wiki/concepts/corpus\"}), encoding=\"utf-8\")\n891\t        scan = os.scandir\n892\t        def denied(path):\n893\t            if Path(path) == corpus:\n894\t                raise PermissionError(13, \"denied\", str(corpus))\n895\t            return scan(path)\n896\t        args = SimpleNamespace(id=\"run\", wiki=self.wiki, skill=self.skill, suite=suite)\n897\t        with mock.patch.object(os, \"scandir\", side_effect=denied):\n898\t            with mock.patch.object(wiki_evolve, \"suite_contract\") as contract:\n899\t                with self.assertRaises(PermissionError):\n900\t                    wiki_evolve.evaluate(args, exp)\n901\t            contract.assert_not_called()\n902\t            with mock.patch.object(loop, \"contract\") as contract:\n903\t                with self.assertRaises(PermissionError):\n904\t                    loop.run(args, self.state)\n905\t            contract.assert_not_called()\n906\t        self.assertFalse(list(exp.glob(\"inputs-*.json\")))\n907\t        self.assertFalse((self.state / \"run\").exists())\n908\t\n909\t    def test_native_posix_names_preserve_backslash_and_check_the_requested_file(self):\n910\t        import posixpath\n911\t        import stat\n912\t        from pathlib import PurePosixPath\n913\t        for relative in (\"concepts/a\\\\b.md\", \"assets\\\\p.md\"):\n914\t            requested = \"/W/\" + relative\n915\t            reads = []\n916\t            class ModelPath(PurePosixPath):\n917\t                def read_bytes(path):\n918\t                    reads.append(str(path))\n919\t                    return b\"ORIGINAL\" if str(path) == requested else b\"DECOY\"\n920\t                def read_text(path, **kwargs):\n921\t                    return path.read_bytes().decode(\"utf-8\")\n922\t            proxy = SimpleNamespace(path=SimpleNamespace(abspath=posixpath.abspath, normcase=posixpath.normcase,\n923\t                                                         realpath=lambda path: str(path), join=posixpath.join),\n924\t                                    fspath=os.fspath)\n925\t            linked = False\n926\t            def attributes(path):\n927\t                return \"ok\", SimpleNamespace(st_mode=stat.S_IFREG if str(path).endswith(\".md\") else stat.S_IFDIR,\n928\t                                              st_nlink=2 if linked and str(path) == requested else 1)\n929\t            with mock.patch.object(wiki_pages, \"os\", proxy), mock.patch.object(wiki_pages, \"Path\", ModelPath), \\\n930\t                 mock.patch.object(wiki_pages, \"NT\", False), mock.patch.object(wiki_pages, \"_stat_entry\", side_effect=attributes):\n931\t                with self.subTest(path=relative):\n932\t                    found = wiki_pages.Walk([SimpleNamespace(rel=relative)], [], [], [])\n933\t                    with mock.patch.object(wiki_pages, \"walk_markdown\", return_value=found):\n934\t                        self.assertEqual([f.rel for f in wiki_pages.walk_pages(ModelPath(\"/W\")).files], [relative])\n935\t                    self.assertEqual(wiki_pages.read_user_bytes(ModelPath(requested), ModelPath(\"/W\")), b\"ORIGINAL\")\n936\t                    self.assertEqual(wiki_pages.read_user_file(ModelPath(requested), ModelPath(\"/W\")), \"ORIGINAL\")\n937\t                    self.assertEqual(reads, [requested, requested])\n938\t                    linked = True\n939\t                    for reader in (wiki_pages.read_user_file, wiki_pages.read_user_bytes):\n940\t                        with self.assertRaisesRegex(ValueError, \"リンク\"):\n941\t                            reader(ModelPath(requested), ModelPath(\"/W\"))\n942\t                    self.assertEqual(reads, [requested, requested])\n943\t\n944\t    def test_physical_evidence_and_index_page_keep_the_native_name(self):\n945\t        import posixpath\n946\t        import stat\n947\t        import wiki_evolve\n948\t        import wiki_index\n949\t        from pathlib import PurePosixPath\n950\t        relative = \"concepts/a\\\\b.md\"\n951\t        requested = \"/W/\" + relative\n952\t        reads = []\n953\t        class ModelPath(PurePosixPath):\n954\t            def resolve(path): return path\n955\t            def exists(path): return str(path) != \"/STATE/sample\"\n956\t            def is_dir(path): return str(path) in (\"/S\", \"/W\", \"/STATE\")\n957\t            def is_file(path): return not path.is_dir()\n958\t            def is_symlink(path): return False\n959\t            def read_bytes(path): return b\"candidate\"\n960\t            def read_text(path, **kwargs):\n961\t                reads.append(str(path))\n962\t                return \"ORIGINAL\" if str(path) == requested else \"DECOY\"\n963\t        proxy = SimpleNamespace(path=SimpleNamespace(abspath=posixpath.abspath, normcase=posixpath.normcase,\n964\t                                                     realpath=lambda path: str(path), join=posixpath.join),\n965\t                                fspath=os.fspath)\n966\t        linked = False\n967\t        def attributes(path):\n968\t            return \"ok\", SimpleNamespace(st_mode=stat.S_IFREG if str(path).endswith(\".md\") else stat.S_IFDIR,\n969\t                                          st_nlink=2 if linked and str(path) == requested else 1)\n970\t        class BeforeStaging(Exception):\n971\t            pass\n972\t        args = SimpleNamespace(id=\"sample\", skill=ModelPath(\"/S\"), candidate=ModelPath(\"/candidate.md\"),\n973\t                               target=\"SKILL.md\", wiki=ModelPath(\"/W\"), reason=\"回帰\", evidence=[relative])\n974\t        with mock.patch.object(wiki_pages, \"os\", proxy), mock.patch.object(wiki_pages, \"Path\", ModelPath), \\\n975\t             mock.patch.object(wiki_pages, \"NT\", False), mock.patch.object(wiki_pages, \"_stat_entry\", side_effect=attributes), \\\n976\t             mock.patch.object(wiki_evolve, \"inside\", side_effect=lambda root, name: ModelPath(str(root) + \"/\" + name)), \\\n977\t             mock.patch.object(wiki_evolve.tempfile, \"TemporaryDirectory\", side_effect=BeforeStaging):\n978\t            with self.assertRaises(BeforeStaging):\n979\t                wiki_evolve.propose(args, ModelPath(\"/STATE\"))\n980\t            self.assertEqual(reads, [requested])\n981\t            linked = True\n982\t            with self.assertRaisesRegex(ValueError, \"リンク\"):\n983\t                wiki_evolve.propose(args, ModelPath(\"/STATE\"))\n984\t            self.assertEqual(reads, [requested])\n985\t            linked = False\n986\t            index = object.__new__(wiki_index.WikiIndex)\n987\t            index.root = ModelPath(\"/W\")\n988\t            index.link_warnings = []\n989\t            index.pages = [{\"rel_path\": relative, \"path\": requested, \"slug\": \"literal\", \"meta\": {}, \"links\": [], \"sections\": []}]\n990\t            with mock.patch.object(wiki_index, \"Path\", ModelPath):\n991\t                result = index.get_page(\"literal\")\n992\t                self.assertEqual(result[\"body\"], \"ORIGINAL\")\n993\t                self.assertEqual(reads, [requested, requested])\n994\t                linked = True\n995\t                with self.assertRaises(wiki_index.LinkRefused):\n996\t                    index.get_page(\"literal\")\n997\t                self.assertEqual(reads, [requested, requested])\n998\t\n999\t    @unittest.skipIf(NT, \"POSIX のファイル名のバックスラッシュを使う\")\n1000\t    def test_posix_candidate_bytes_are_from_the_named_file(self):\n1001\t        import wiki_evolve\n1002\t        candidate = self.write(\"concepts/a\\\\b.md\", \"ORIGINAL\")\n1003\t        self.write(\"concepts/a/b.md\", \"DECOY\")\n1004\t        wiki_evolve.propose(self.args(candidate), self.state)\n1005\t        self.assertEqual((self.state / \"sample/candidate/SKILL.md\").read_bytes(), b\"ORIGINAL\")\n1006\t        outside = self.write(\"candidate.md\", \"after\", self.ext)\n1007\t        wiki_evolve.propose(self.args(outside, id=\"evidence\", evidence=[\"concepts/a\\\\b.md\"]), self.state)\n1008\t        proposal = json.loads((self.state / \"evidence/proposal.json\").read_text(encoding=\"utf-8\"))\n1009\t        self.assertEqual(proposal[\"evidence\"][\"concepts/a\\\\b.md\"], \"ORIGINAL\")\n1010\t        import wiki_index\n1011\t        self.write(\"indexes/a\\\\b.md\", \"# ORIGINAL\")\n1012\t        self.write(\"indexes/a/b.md\", \"# DECOY\")\n1013\t        rows = {row[\"name\"]: row[\"title\"] for row in wiki_index.list_index(self.wiki)[\"indexes\"]}\n1014\t        self.assertEqual(rows[\"a\\\\b.md\"], \"ORIGINAL\")\n1015\t        self.assertEqual(rows[\"a/b.md\"], \"DECOY\")\n1016\t        os.link(candidate, self.ext / \"copy.md\")\n1017\t        with self.assertRaisesRegex(ValueError, \"リンク\"):\n1018\t            wiki_evolve.propose(self.args(candidate, id=\"linked\"), self.state)\n1019\t        with self.assertRaisesRegex(ValueError, \"リンク\"):\n1020\t            wiki_evolve.propose(self.args(outside, id=\"linked-evidence\", evidence=[\"concepts/a\\\\b.md\"]), self.state)\n1021\t\n1022\t\n1023\tclass ReadSiteInventoryTests(unittest.TestCase):\n1024\t    \"\"\"スクリプトの中のファイルの読み取り（read_text、read_bytes、open）を、関数ごとに 1 度ずつ分類する。"}]},"parent_tool_use_id":null,"session_id":"b80a7cfc-5124-475e-a5d7-29e8b293e114","uuid":"8c365c98-9f98-4515-b127-d89ae3a3bcbc","timestamp":"2026-11-17T14:50:45.995Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Works\\info-hive-dev\\.claude\\worktrees\\adr-0029-impl\\tests\\wiki\\test_wiki_links.py","content":"class ReviewFiveTests(Base):\n    \"\"\"第5回の反例を、実ファイルと入口の実行で検査する。\"\"\"\n\n    def setUp(self):\n        super().setUp()\n        self.skill = self.ext / \"skill\"\n        self.skill.mkdir()\n        (self.skill / \"SKILL.md\").write_text(\"before\", encoding=\"utf-8\")\n        self.state = self.wiki / \".evolution\"\n        self.state.mkdir()\n        self.write(\"concepts/evidence.md\", page(\"evidence\"))\n\n    def args(self, candidate, **values):\n        return SimpleNamespace(**dict(dict(id=\"sample\", skill=self.skill, candidate=candidate,\n                                          target=\"SKILL.md\", wiki=self.wiki, reason=\"回帰の確認\",\n                                          evidence=[\"concepts/evidence.md\"]), **values))\n\n    def record_reads(self, reads):\n        original = Path.read_bytes\n        def read(path):\n            reads.append(path)\n            return original(path)\n        return mock.patch.object(Path, \"read_bytes\", read)\n\n    def directory_case(self):\n        directory = self.wiki / \"concepts/candidate\"\n        directory.mkdir()\n        (directory / \"SKILL.md\").write_text(\"after\", encoding=\"utf-8\")\n        linked = directory / \"p.md\"\n        linked.write_text(\"refused\", encoding=\"utf-8\")\n        os.link(linked, self.ext / \"copy.md\")\n        return directory, linked\n\n    def assert_directory_refused(self, directory, linked):\n        import wiki_evolve\n        reads = []\n        with self.record_reads(reads), wiki_pages.capture_notices() as notices:\n            with self.assertRaisesRegex(ValueError, \"リンク\"):\n                wiki_evolve.propose(self.args(directory, target=None), self.state)\n        self.assertNotIn(linked, reads, \"拒むべき記事の本文を読んだ\")\n        self.assertIn({\"path\": \"concepts/candidate/p.md\", \"kind\": \"hardlink\"}, notices.items)\n        self.assertFalse((self.state / \"sample\").exists())\n\n    def test_directory_candidate_refuses_before_reading(self):\n        self.assert_directory_refused(*self.directory_case())\n\n    def test_regression_catches_tree_that_drops_the_wiki(self):\n        \"\"\"読む口の呼び出し名が残っていても、wiki の引き渡しを欠く実装を検出する。\"\"\"\n        import wiki_evolve\n        directory, linked = self.directory_case()\n        original = wiki_evolve.tree\n        with mock.patch.object(wiki_evolve, \"tree\", side_effect=lambda root, wiki_root=None: original(root)):\n            with self.assertRaises(AssertionError):\n                self.assert_directory_refused(directory, linked)\n\n    def test_installed_skill_under_wiki_is_also_checked(self):\n        import wiki_evolve\n        source, linked = self.directory_case()\n        candidate = self.write(\"candidate.md\", \"after\", self.ext)\n        reads = []\n        with self.record_reads(reads):\n            with self.assertRaisesRegex(ValueError, \"リンク\"):\n                wiki_evolve.propose(self.args(candidate, skill=source), self.state)\n        self.assertNotIn(linked, reads)\n\n    def test_single_candidates_preserve_bytes_and_article_scope(self):\n        import wiki_evolve\n        data = b\"after\\r\\nwith CRLF\\r\\n\"\n        cases = [(self.ext, \"outside.md\"), (self.wiki, \"concepts/candidate.md\"),\n                 (self.wiki, \"assets/candidate.md\"), (self.wiki, \"candidate.txt\"),\n                 (self.wiki, \".hidden/candidate.md\")]\n        for number, (root, name) in enumerate(cases):\n            with self.subTest(path=name):\n                path = root / name\n                path.parent.mkdir(parents=True, exist_ok=True)\n                path.write_bytes(data)\n                result = wiki_evolve.propose(self.args(path, id=f\"case-{number}\"), self.state)\n                self.assertEqual(result[\"status\"], \"proposed\")\n                self.assertEqual((self.state / f\"case-{number}/candidate/SKILL.md\").read_bytes(), data)\n\n    def test_single_linked_article_is_not_read(self):\n        import wiki_evolve\n        linked = self.write(\"concepts/candidate.md\", \"refused\")\n        os.link(linked, self.ext / \"copy.md\")\n        reads = []\n        with self.record_reads(reads):\n            with self.assertRaisesRegex(ValueError, \"リンク\"):\n                wiki_evolve.propose(self.args(linked), self.state)\n        self.assertNotIn(linked, reads)\n\n    def proposal(self):\n        import wiki_evolve\n        candidate = self.write(\"candidate.md\", \"after\", self.ext)\n        wiki_evolve.propose(self.args(candidate), self.state)\n        return self.state / \"sample\"\n\n    def test_evaluate_refuses_original_corpus_before_reading(self):\n        import wiki_evolve\n        exp = self.proposal()\n        linked = self.write(\"concepts/p.md\", \"refused\")\n        os.link(linked, self.ext / \"copy.md\")\n        suite = self.tmp / \"suite.json\"\n        suite.write_text(json.dumps({\"corpus\": \"wiki\"}), encoding=\"utf-8\")\n        reads = []\n        with self.record_reads(reads), mock.patch.object(wiki_evolve, \"suite_contract\") as contract:\n            with self.assertRaisesRegex(ValueError, \"リンク\"):\n                wiki_evolve.evaluate(SimpleNamespace(suite=suite, wiki=self.wiki), exp)\n        contract.assert_not_called()\n        self.assertNotIn(linked, reads)\n        self.assertFalse(list(exp.glob(\"inputs-*.json\")))\n\n    def test_nonarticle_hardlink_is_allowed_in_corpus_and_copy(self):\n        import wiki_evolve\n        import wiki_evolve_loop as loop\n        path = self.write(\"assets/image.dat\", \"asset\")\n        os.link(path, self.ext / \"copy.dat\")\n        wiki_evolve.tree(self.wiki, self.wiki)\n        dest = self.ext / \"snapshot\"\n        wiki_evolve.copy_tree(self.wiki, dest, self.wiki)\n        self.assertEqual((dest / \"assets/image.dat\").read_text(encoding=\"utf-8\"), \"asset\")\n        suite = self.tmp / \"suite.json\"\n        suite.write_text(json.dumps({\"corpus\": \"wiki\"}), encoding=\"utf-8\")\n        args = SimpleNamespace(id=\"run\", skill=self.skill, wiki=self.wiki, suite=suite)\n        class ReachedContract(Exception):\n            pass\n        with mock.patch.object(loop, \"contract\", side_effect=ReachedContract):\n            with self.assertRaises(ReachedContract):\n                loop.run(args, self.state)\n\n    def test_parent_segments_are_rejected_before_reading_or_normalizing(self):\n        paths = [self.wiki / \"concepts/jump/../candidate.md\", self.ext / \"../candidate.md\"]\n        for path in paths:\n            for reader in (wiki_pages.read_user_file, wiki_pages.read_user_bytes):\n                with self.subTest(path=str(path), reader=reader.__name__):\n                    with mock.patch.object(os.path, \"abspath\", side_effect=AssertionError(\"正規化してはいけない\")):\n                        with self.assertRaisesRegex(ValueError, r\"\\.\\.\"):\n                            reader(path, self.wiki)\n\n    def test_parent_segments_in_propose_are_rejected(self):\n        import wiki_evolve\n        candidate = self.wiki / \"concepts/jump/../candidate.md\"\n        with self.assertRaisesRegex(ValueError, r\"\\.\\.\"):\n            wiki_evolve.propose(self.args(candidate), self.state)\n\n    @unittest.skipIf(NT, \"POSIX のシンボリックリンクと .. の解決を使う\")\n    def test_posix_parent_after_symlink_never_reads_a_decoy(self):\n        import wiki_evolve\n        (self.wiki / \"other/deep\").mkdir(parents=True)\n        os.symlink(self.wiki / \"other/deep\", self.wiki / \"concepts/jump\", target_is_directory=True)\n        self.write(\"concepts/candidate.md\", \"decoy\")\n        linked = self.write(\"other/candidate.md\", \"refused\")\n        os.link(linked, self.ext / \"copy.md\")\n        candidate = self.wiki / \"concepts/jump/../candidate.md\"\n        for reader in (wiki_pages.read_user_file, wiki_pages.read_user_bytes):\n            with self.assertRaisesRegex(ValueError, r\"\\.\\.\"):\n                reader(candidate, self.wiki)\n        with self.assertRaisesRegex(ValueError, r\"\\.\\.\"):\n            wiki_evolve.propose(self.args(candidate), self.state)\n\n\n    def test_cli_keeps_protection_through_root_alias_and_outgoing_junction(self):\n        outside = self.write(\"p.md\", \"refused\", self.ext)\n        view = self.tmp / \"view\"\n        if not junction(view, self.wiki) or not junction(self.wiki / \"concepts/jump\", self.ext):\n            self.skipTest(\"ディレクトリのリンクを作れない\")\n        alias = view / \"concepts/jump/p.md\"\n        for reader in (wiki_pages.read_user_file, wiki_pages.read_user_bytes):\n            with wiki_pages.capture_notices() as notices:\n                with self.assertRaisesRegex(ValueError, \"リンク\"):\n                    reader(alias, self.wiki)\n            self.assertTrue(notices.items)\n        done = subprocess.run([sys.executable, \"-X\", \"utf8\", \"-B\", str(SCRIPTS / \"wiki_evolve.py\"),\n                               \"--wiki\", str(view), \"propose\", \"--id\", \"alias\", \"--skill\", str(self.skill),\n                               \"--candidate\", str(alias), \"--target\", \"SKILL.md\", \"--reason\", \"回帰\",\n                               \"--evidence\", \"concepts/evidence.md\"],\n                              capture_output=True, encoding=\"utf-8\", timeout=20)\n        self.assertEqual(done.returncode, 1, done.stdout + done.stderr)\n        self.assertIn(\"リンク\", done.stderr)\n        self.assertFalse((self.state / \"alias\").exists())\n        self.assertEqual(outside.read_text(encoding=\"utf-8\"), \"refused\")\n\n    def nested_corpus(self, prefix=\"concepts\"):\n        corpus = self.wiki / prefix / \"corpus\"\n        linked = self.write(f\"{prefix}/corpus/assets/p.md\", \"refused\")\n        os.link(linked, self.ext / \"copy.md\")\n        suite = corpus.parent / \"suite.json\"\n        suite.write_text(json.dumps({\"corpus\": \"corpus\"}), encoding=\"utf-8\")\n        return corpus, linked, suite\n\n    def assert_nested_loop_refused(self, linked, suite):\n        import wiki_evolve_loop as loop\n        class ReachedContract(Exception):\n            pass\n        args = SimpleNamespace(id=\"run\", wiki=self.wiki, skill=self.skill, suite=suite)\n        reads = []\n        with self.record_reads(reads), mock.patch.object(loop, \"contract\", side_effect=ReachedContract) as contract:\n            with wiki_pages.capture_notices() as notices:\n                try:\n                    loop.run(args, self.state)\n                except ValueError as exc:\n                    self.assertIn(\"リンク\", str(exc))\n                except ReachedContract:\n                    self.fail(\"リンクの記事を拒否せず contract に進んだ\")\n                else:\n                    self.fail(\"リンクの記事を拒否しなかった\")\n        contract.assert_not_called()\n        self.assertNotIn(linked, reads)\n        self.assertTrue(notices.items)\n\n    def test_nested_corpus_uses_the_original_wiki_in_both_entries(self):\n        import wiki_evolve\n        exp = self.proposal()\n        corpus, linked, suite = self.nested_corpus()\n        self.assertEqual(wiki_pages.source_wiki_root(corpus, self.wiki), self.wiki)\n        self.assert_nested_loop_refused(linked, suite)\n        reads = []\n        with self.record_reads(reads), mock.patch.object(wiki_evolve, \"suite_contract\") as contract:\n            with self.assertRaisesRegex(ValueError, \"リンク\"):\n                wiki_evolve.evaluate(SimpleNamespace(wiki=self.wiki, suite=suite), exp)\n        contract.assert_not_called()\n        self.assertNotIn(linked, reads)\n\n    def test_regression_catches_a_wrong_corpus_root(self):\n        corpus, linked, suite = self.nested_corpus()\n        with mock.patch.object(wiki_pages, \"source_wiki_root\", side_effect=lambda path, wiki=None: path):\n            with self.assertRaises(AssertionError):\n                self.assert_nested_loop_refused(linked, suite)\n\n    def test_corpus_in_excluded_tree_does_not_create_new_articles(self):\n        import wiki_evolve\n        corpus, linked, suite = self.nested_corpus(prefix=\"assets\")\n        root = wiki_pages.source_wiki_root(corpus, self.wiki)\n        self.assertEqual(root, self.wiki)\n        target = self.ext / \"snapshot\"\n        wiki_evolve.copy_tree(corpus, target, root)\n        self.assertEqual((target / \"assets/p.md\").read_text(encoding=\"utf-8\"), \"refused\")\n        self.assertEqual(wiki_pages.article_path(self.wiki, \"assets/corpus/assets/p.md\").state, \"not_article\")\n\n    def test_linked_directory_is_rejected_before_walking(self):\n        import wiki_evolve\n        jump = self.wiki / \"concepts/jump\"\n        if not junction(jump, self.ext):\n            self.skipTest(\"ディレクトリのリンクを作れない\")\n        with mock.patch.object(wiki_evolve.os, \"walk\", side_effect=AssertionError(\"リンクに降りてはいけない\")):\n            with self.assertRaisesRegex(ValueError, \"リンク\"):\n                wiki_evolve.tree(jump, self.wiki)\n\n    def test_posix_colon_reaches_the_same_link_check_as_other_articles(self):\n        import stat\n        def attributes(path):\n            return \"ok\", SimpleNamespace(st_mode=stat.S_IFREG if str(path).endswith(\"a:b.md\") else stat.S_IFDIR,\n                                          st_nlink=2 if str(path).endswith(\"a:b.md\") else 1)\n        with mock.patch.object(wiki_pages, \"NT\", False), mock.patch.object(wiki_pages, \"_stat_entry\", side_effect=attributes) as lookup:\n            for reader in (wiki_pages.read_user_file, wiki_pages.read_user_bytes):\n                with self.assertRaisesRegex(ValueError, \"リンク\"):\n                    reader(self.wiki / \"concepts/a:b.md\", self.wiki)\n        self.assertGreater(lookup.call_count, 0)\n\n    @unittest.skipIf(NT, \"POSIX のファイル名の : を使う\")\n    def test_posix_colon_hardlink_is_not_read(self):\n        linked = self.write(\"concepts/a:b.md\", \"refused\")\n        os.link(linked, self.ext / \"copy.md\")\n        with self.assertRaisesRegex(ValueError, \"リンク\"):\n            wiki_pages.read_user_bytes(linked, self.wiki)\n\n    def test_case_conversion_does_not_change_relative_path_offsets(self):\n        root = self.tmp / \"W\\u0130\"\n        found = wiki_pages._article_rel(root / \"concepts/p.md\", root)\n        self.assertEqual(found, (str(root), \"concepts/p.md\"))\n\n    def test_unlistable_root_and_subdirectory_never_become_empty_snapshots(self):\n        import wiki_evolve\n        root = self.ext / \"input\"\n        (root / \"sub\").mkdir(parents=True)\n        (root / \"sub/p.md\").write_text(\"data\", encoding=\"utf-8\")\n        scan = os.scandir\n        for blocked in (root, root / \"sub\"):\n            def denied(path):\n                if Path(path) == blocked:\n                    raise PermissionError(13, \"denied\", str(blocked))\n                return scan(path)\n            for copy in (False, True):\n                with self.subTest(blocked=str(blocked), copy=copy):\n                    dest = self.ext / \"snapshot\"\n                    with mock.patch.object(os, \"scandir\", side_effect=denied):\n                        with self.assertRaises(PermissionError) as error:\n                            if copy:\n                                wiki_evolve.copy_tree(root, dest, root)\n                            else:\n                                wiki_evolve.tree(root, root)\n                    self.assertEqual(error.exception.filename, str(blocked))\n                    self.assertFalse(dest.exists())\n\n    def test_both_corpus_entries_stop_before_contract_on_listing_error(self):\n        import wiki_evolve\n        import wiki_evolve_loop as loop\n        exp = self.proposal()\n        corpus = self.wiki / \"concepts/corpus\"\n        corpus.mkdir()\n        suite = self.tmp / \"suite.json\"\n        suite.write_text(json.dumps({\"corpus\": \"wiki/concepts/corpus\"}), encoding=\"utf-8\")\n        scan = os.scandir\n        def denied(path):\n            if Path(path) == corpus:\n                raise PermissionError(13, \"denied\", str(corpus))\n            return scan(path)\n        args = SimpleNamespace(id=\"run\", wiki=self.wiki, skill=self.skill, suite=suite)\n        with mock.patch.object(os, \"scandir\", side_effect=denied):\n            with mock.patch.object(wiki_evolve, \"suite_contract\") as contract:\n                with self.assertRaises(PermissionError):\n                    wiki_evolve.evaluate(args, exp)\n            contract.assert_not_called()\n            with mock.patch.object(loop, \"contract\") as contract:\n                with self.assertRaises(PermissionError):\n                    loop.run(args, self.state)\n            contract.assert_not_called()\n        self.assertFalse(list(exp.glob(\"inputs-*.json\")))\n        self.assertFalse((self.state / \"run\").exists())\n\n    def test_native_posix_names_preserve_backslash_and_check_the_requested_file(self):\n        import posixpath\n        import stat\n        from pathlib import PurePosixPath\n        for relative in (\"concepts/a\\\\b.md\", \"assets\\\\p.md\"):\n            requested = \"/W/\" + relative\n            reads = []\n            class ModelPath(PurePosixPath):\n                def read_bytes(path):\n                    reads.append(str(path))\n                    return b\"ORIGINAL\" if str(path) == requested else b\"DECOY\"\n                def read_text(path, **kwargs):\n                    return path.read_bytes().decode(\"utf-8\")\n            proxy = SimpleNamespace(path=SimpleNamespace(abspath=posixpath.abspath, normcase=posixpath.normcase,\n                                                         realpath=lambda path: str(path), join=posixpath.join),\n                                    fspath=os.fspath)\n            linked = False\n            def attributes(path):\n                return \"ok\", SimpleNamespace(st_mode=stat.S_IFREG if str(path).endswith(\".md\") else stat.S_IFDIR,\n                                              st_nlink=2 if linked and str(path) == requested else 1)\n            with mock.patch.object(wiki_pages, \"os\", proxy), mock.patch.object(wiki_pages, \"Path\", ModelPath), \\\n                 mock.patch.object(wiki_pages, \"NT\", False), mock.patch.object(wiki_pages, \"_stat_entry\", side_effect=attributes):\n                with self.subTest(path=relative):\n                    found = wiki_pages.Walk([SimpleNamespace(rel=relative)], [], [], [])\n                    with mock.patch.object(wiki_pages, \"walk_markdown\", return_value=found):\n                        self.assertEqual([f.rel for f in wiki_pages.walk_pages(ModelPath(\"/W\")).files], [relative])\n                    self.assertEqual(wiki_pages.read_user_bytes(ModelPath(requested), ModelPath(\"/W\")), b\"ORIGINAL\")\n                    self.assertEqual(wiki_pages.read_user_file(ModelPath(requested), ModelPath(\"/W\")), \"ORIGINAL\")\n                    self.assertEqual(reads, [requested, requested])\n                    linked = True\n                    for reader in (wiki_pages.read_user_file, wiki_pages.read_user_bytes):\n                        with self.assertRaisesRegex(ValueError, \"リンク\"):\n                            reader(ModelPath(requested), ModelPath(\"/W\"))\n                    self.assertEqual(reads, [requested, requested])\n\n    def test_physical_evidence_and_index_page_keep_the_native_name(self):\n        import posixpath\n        import stat\n        import wiki_evolve\n        import wiki_index\n        from pathlib import PurePosixPath\n        relative = \"concepts/a\\\\b.md\"\n        requested = \"/W/\" + relative\n        reads = []\n        class ModelPath(PurePosixPath):\n            def resolve(path): return path\n            def exists(path): return str(path) != \"/STATE/sample\"\n            def is_dir(path): return str(path) in (\"/S\", \"/W\", \"/STATE\")\n            def is_file(path): return not path.is_dir()\n            def is_symlink(path): return False\n            def read_bytes(path): return b\"candidate\"\n            def read_text(path, **kwargs):\n                reads.append(str(path))\n                return \"ORIGINAL\" if str(path) == requested else \"DECOY\"\n        proxy = SimpleNamespace(path=SimpleNamespace(abspath=posixpath.abspath, normcase=posixpath.normcase,\n                                                     realpath=lambda path: str(path), join=posixpath.join),\n                                fspath=os.fspath)\n        linked = False\n        def attributes(path):\n            return \"ok\", SimpleNamespace(st_mode=stat.S_IFREG if str(path).endswith(\".md\") else stat.S_IFDIR,\n                                          st_nlink=2 if linked and str(path) == requested else 1)\n        class BeforeStaging(Exception):\n            pass\n        args = SimpleNamespace(id=\"sample\", skill=ModelPath(\"/S\"), candidate=ModelPath(\"/candidate.md\"),\n                               target=\"SKILL.md\", wiki=ModelPath(\"/W\"), reason=\"回帰\", evidence=[relative])\n        with mock.patch.object(wiki_pages, \"os\", proxy), mock.patch.object(wiki_pages, \"Path\", ModelPath), \\\n             mock.patch.object(wiki_pages, \"NT\", False), mock.patch.object(wiki_pages, \"_stat_entry\", side_effect=attributes), \\\n             mock.patch.object(wiki_evolve, \"inside\", side_effect=lambda root, name: ModelPath(str(root) + \"/\" + name)), \\\n             mock.patch.object(wiki_evolve.tempfile, \"TemporaryDirectory\", side_effect=BeforeStaging):\n            with self.assertRaises(BeforeStaging):\n                wiki_evolve.propose(args, ModelPath(\"/STATE\"))\n            self.assertEqual(reads, [requested])\n            linked = True\n            with self.assertRaisesRegex(ValueError, \"リンク\"):\n                wiki_evolve.propose(args, ModelPath(\"/STATE\"))\n            self.assertEqual(reads, [requested])\n            linked = False\n            index = object.__new__(wiki_index.WikiIndex)\n            index.root = ModelPath(\"/W\")\n            index.link_warnings = []\n            index.pages = [{\"rel_path\": relative, \"path\": requested, \"slug\": \"literal\", \"meta\": {}, \"links\": [], \"sections\": []}]\n            with mock.patch.object(wiki_index, \"Path\", ModelPath):\n                result = index.get_page(\"literal\")\n                self.assertEqual(result[\"body\"], \"ORIGINAL\")\n                self.assertEqual(reads, [requested, requested])\n                linked = True\n                with self.assertRaises(wiki_index.LinkRefused):\n                    index.get_page(\"literal\")\n                self.assertEqual(reads, [requested, requested])\n\n    @unittest.skipIf(NT, \"POSIX のファイル名のバックスラッシュを使う\")\n    def test_posix_candidate_bytes_are_from_the_named_file(self):\n        import wiki_evolve\n        candidate = self.write(\"concepts/a\\\\b.md\", \"ORIGINAL\")\n        self.write(\"concepts/a/b.md\", \"DECOY\")\n        wiki_evolve.propose(self.args(candidate), self.state)\n        self.assertEqual((self.state / \"sample/candidate/SKILL.md\").read_bytes(), b\"ORIGINAL\")\n        outside = self.write(\"candidate.md\", \"after\", self.ext)\n        wiki_evolve.propose(self.args(outside, id=\"evidence\", evidence=[\"concepts/a\\\\b.md\"]), self.state)\n        proposal = json.loads((self.state / \"evidence/proposal.json\").read_text(encoding=\"utf-8\"))\n        self.assertEqual(proposal[\"evidence\"][\"concepts/a\\\\b.md\"], \"ORIGINAL\")\n        import wiki_index\n        self.write(\"indexes/a\\\\b.md\", \"# ORIGINAL\")\n        self.write(\"indexes/a/b.md\", \"# DECOY\")\n        rows = {row[\"name\"]: row[\"title\"] for row in wiki_index.list_index(self.wiki)[\"indexes\"]}\n        self.assertEqual(rows[\"a\\\\b.md\"], \"ORIGINAL\")\n        self.assertEqual(rows[\"a/b.md\"], \"DECOY\")\n        os.link(candidate, self.ext / \"copy.md\")\n        with self.assertRaisesRegex(ValueError, \"リンク\"):\n            wiki_evolve.propose(self.args(candidate, id=\"linked\"), self.state)\n        with self.assertRaisesRegex(ValueError, \"リンク\"):\n            wiki_evolve.propose(self.args(outside, id=\"linked-evidence\", evidence=[\"concepts/a\\\\b.md\"]), self.state)\n\n\nclass ReadSiteInventoryTests(unittest.TestCase):\n    \"\"\"スクリプトの中のファイルの読み取り（read_text、read_bytes、open）を、関数ごとに 1 度ずつ分類する。","numLines":435,"startLine":590,"totalLines":1215}},"tool_result_meta":[{"id":"toolu_011GhxVDrnJU4gB5DouiMm1w","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
