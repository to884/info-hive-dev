{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SDYDi8wkCvsQ5porY8aaCU","type":"tool_result","content":"140\t    \"\"\"入力の一覧（設計の 4）。(種類, ディスク上の相対パス, 大きさ, 更新時刻) の並び。分からなければ InputsUnknown。\n141\t\n142\t    写しが読むものも、変化を知るための印も、比べる 2 回の走査も、この 1 つの一覧から作る。\n143\t    \"\"\"\n144\t    entries, problem = fs.walk_inputs(root)\n145\t    if problem is not None:\n146\t        raise InputsUnknown(problem)\n147\t    return tuple(entries)\n148\t\n149\t\n150\tdef signature_of(entries) -> str:\n151\t    \"\"\"入力の印。入力の一覧の、種類、相対パス、大きさ、更新時刻から作る。\"\"\"\n152\t    h = hashlib.sha256()\n153\t    for kind, rel, size, mtime in entries:\n154\t        h.update(f\"{kind}\\0{rel}\\0{size}\\0{mtime}\\n\".encode(\"utf-8\"))\n155\t    return h.hexdigest()\n156\t\n157\t\n158\tdef signature(root) -> str:\n159\t    \"\"\"今の入力の印。名前の集合が分からなければ InputsUnknown。\"\"\"\n160\t    return signature_of(input_list(root))\n161\t\n162\t\n163\tdef read_text_like_lint(data: bytes) -> str:\n164\t    \"\"\"lint の read_text(encoding=\"utf-8-sig\") と同じ文字にする。BOM を除き、改行を LF にそろえる。\"\"\"\n165\t    return io.TextIOWrapper(io.BytesIO(data), encoding=\"utf-8-sig\", newline=None).read()\n166\t\n167\t\n168\t@dataclass\n169\tclass Snapshot:\n170\t    \"\"\"写し。inputs と generation が内容、signature と unreadable が読み取りの情報である（設計の 8）。\"\"\"\n171\t    signature: str\n172\t    inputs: list\n173\t    generation: str\n174\t    unreadable: list = field(default_factory=list)   # 中身を読めなかった入力の (種類, 相対パス)（UTF-8 でないものを含む）\n175\t    entries: tuple = ()                              # 入力の一覧（読み取りの情報。公開の前の検査が使う）\n176\t    transient: list = field(default_factory=list)    # そのうち、開けなかった入力（ファイルを変えずに読めるようになりうる）\n177\t\n178\t    def by_kind(self, kind: str) -> list:\n179\t        return [f for f in self.inputs if f.kind == kind]\n180\t\n181\t\n182\t# XML 1.0 の文書に現れてよい文字（Char）の外。NUL と、タブ、改行、復帰のほかの制御文字を含む\n183\t_XML_ILLEGAL_RE = re.compile(\"[^\\t\\n\\r\\u0020-\\ud7ff\\ue000-\\ufffd\\U00010000-\\U0010ffff]\")\n184\t# XML の宣言。文法（XMLDecl ::= '<?xml' VersionInfo ...、VersionInfo は空白で始まる）どおり、<?xml のあとに空白が要る。\n185\t# \\b にすると <?xml-stylesheet ...?> の処理命令を宣言と取り違える（実装の 2 回目のレビューの軽微）\n186\t_XML_DECL_RE = re.compile(r\"\\A<\\?xml[ \\t\\r\\n](.*?)\\?>\", re.S)\n187\t_XML_ENCODING_RE = re.compile(r\"\"\"\\bencoding\\s*=\\s*[\"']([^\"']*)[\"']\"\"\")\n188\t\n189\t\n190\tdef is_utf8_svg(data: bytes) -> bool:\n191\t    \"\"\"svg のバイト列を、XML として UTF-8 で読むなら真（図の描画の設計の 6.2）。\n192\t\n193\t    公開の前の検査（scan_machine_info）は UTF-8 で読むので、XML として別の符号化で読まれる svg を出力に書くと、\n194\t    中の絶対パスとトークンを見つけられない。UTF-8 として読めるだけでは足りない。BOM のない UTF-16 の、ASCII の\n195\t    文字だけの XML は、UTF-8 としても読めるからである（実装の 1 回目のレビューの重大）。そこで次の 3 つを求める。\n196\t    - UTF-8（BOM はあってもよい）として読める。\n197\t    - XML 1.0 で許される文字だけからなる。UTF-16 と UTF-32 の ASCII の文字は NUL を伴うので、ここで落ちる。\n198\t    - 先頭の XML の宣言が、UTF-8 のほかの符号化を名乗らない。\n199\t    \"\"\"\n200\t    try:\n201\t        text = data.decode(\"utf-8-sig\")\n202\t    except UnicodeDecodeError:\n203\t        return False\n204\t    if _XML_ILLEGAL_RE.search(text):\n205\t        return False\n206\t    decl = _XML_DECL_RE.match(text)\n207\t    if decl is None:\n208\t        return True\n209\t    enc = _XML_ENCODING_RE.search(decl.group(1))\n210\t    return enc is None or enc.group(1).strip().lower() in (\"utf-8\", \"utf8\")\n211\t\n212\t\n213\t_SVG_LENGTH_RE = re.compile(r\"\\s*([0-9]+(?:\\.[0-9]+)?)\\s*(?:px)?\\s*\")\n214\t\n215\t\n216\tclass _RootFound(Exception):\n217\t    \"\"\"svg_size が、根の要素の開始タグか DTD を読んだところで、解析を止める。\"\"\"\n218\t\n219\t\n220\tdef _svg_root_attrs(data: bytes) -> \"dict | None\":\n221\t    \"\"\"svg の根の要素の属性を、標準ライブラリの expat で読む。根が svg でないか、XML として読めないか、DTD が\n222\t    あれば None。根の開始タグを読んだところで止めるので、それより後は解析しない。DTD があれば、その始まりで\n223\t    止める（実体の定義を展開させない）。正規表現で探すと、コメントの中の <svg や data-width を拾う（実装の 1 回目の\n224\t    レビューの軽微）。\"\"\"\n225\t    import xml.parsers.expat\n226\t    found = {}\n227\t\n228\t    def start(name, attrs):\n229\t        found[\"name\"], found[\"attrs\"] = name, attrs\n230\t        raise _RootFound\n231\t\n232\t    def doctype(*_args):\n233\t        found[\"dtd\"] = True\n234\t        raise _RootFound\n235\t\n236\t    parser = xml.parsers.expat.ParserCreate()\n237\t    parser.StartElementHandler = start\n238\t    parser.StartDoctypeDeclHandler = doctype\n239\t    try:\n240\t        parser.Parse(data, True)\n241\t    except _RootFound:\n242\t        pass\n243\t    except (xml.parsers.expat.ExpatError, ValueError):\n244\t        return None\n245\t    name = found.get(\"name\")\n246\t    if found.get(\"dtd\") or name is None or name.rpartition(\":\")[2] != \"svg\":\n247\t        return None\n248\t    return found[\"attrs\"]\n249\t\n250\t\n251\tdef svg_size(data: bytes) -> \"tuple | None\":\n252\t    \"\"\"svg の根の要素の width と height（なければ viewBox）から、表示の大きさ (幅, 高さ) を整数で返す。\n253\t\n254\t    分からなければ None。<img> の width と height の属性にして、読み込む前から入れ物の幅を決める（WebKit は、幅を\n255\t    中身で決める入れ物の中の画像を、読み込んだあとに組み直さない）。単位は px か、単位なしだけを読む。\n256\t    \"\"\"\n257\t    if not is_utf8_svg(data):\n258\t        return None\n259\t    attrs = _svg_root_attrs(data)\n260\t    if attrs is None:\n261\t        return None\n262\t    w = _SVG_LENGTH_RE.fullmatch(attrs.get(\"width\", \"\"))\n263\t    h = _SVG_LENGTH_RE.fullmatch(attrs.get(\"height\", \"\"))\n264\t    if w and h:\n265\t        size = (float(w.group(1)), float(h.group(1)))\n266\t    else:\n267\t        parts = re.split(r\"[\\s,]+\", attrs.get(\"viewBox\", \"\").strip())\n268\t        try:\n269\t            nums = [float(p) for p in parts] if len(parts) == 4 else []\n270\t        except ValueError:\n271\t            nums = []\n272\t        if not nums:\n273\t            return None\n274\t        size = (nums[2], nums[3])\n275\t    if not all(0 < v <= 20000 for v in size):\n276\t        return None\n277\t    return round(size[0]) or 1, round(size[1]) or 1\n278\t\n279\t\n280\tdef _read_asset(root, f: InputFile, size) -> None:\n281\t    \"\"\"図の svg を読み、f の data、sha、error を決める。上限は読む口が強制する（図の描画の設計の 6.2）。\"\"\"\n282\t    if size is None:\n283\t        f.error = \"os\"\n284\t        return\n285\t    if size > ASSET_MAX_BYTES:\n286\t        f.error = \"too_large\"\n287\t        return\n288\t    try:\n289\t        data = fs.read_input_capped(root, f.disk_rel, ASSET_MAX_BYTES)\n290\t    except fs.TooLarge:\n291\t        f.error = \"too_large\"\n292\t        return\n293\t    except (fs.Unknown, fs.Absent):\n294\t        f.error = \"os\"\n295\t        return\n296\t    f.sha = hashlib.sha256(data).hexdigest()\n297\t    if not is_utf8_svg(data):\n298\t        f.error = \"decode\"\n299\t        return\n300\t    f.data = data\n301\t\n302\t\n303\tdef take_snapshot(root, entries=None) -> Snapshot:\n304\t    \"\"\"入力の一覧を作り、入力を読み、もう 1 度一覧を作る。2 回が同じときだけ、写しを採る（設計の 4.2）。\n305\t\n306\t    違えば InputsChanged、名前の集合が分からなければ InputsUnknown。中身を読めない入力は、その入力がない Wiki と\n307\t    同じに描き、読み取りの印を足す（設計の 4.1）。\n308\t    \"\"\"\n309\t    first = input_list(root) if entries is None else tuple(entries)\n310\t    inputs = []\n311\t    unreadable = []\n312\t    transient = []\n313\t    gen = hashlib.sha256(CORE_VERSION.encode(\"utf-8\"))\n314\t    for kind, rel_disk, size, _mtime in first:\n315\t        if kind == \"link\":\n316\t            # リンクなので読まない（ADR-0029）。読まないことも内容なので、世代に入れる\n317\t            gen.update(f\"link\\0{rel_disk}\\0{_mtime}\\n\".encode(\"utf-8\"))\n318\t            continue\n319\t        f = InputFile(kind=kind, disk_rel=rel_disk, rel=posix_rel(rel_disk))\n320\t        if kind in (\"asset\", \"asset_dir\"):\n321\t            _read_asset(root, f, size)     # asset_dir（assets/ の一覧を作れない）は大きさがなく、読めない入力になる\n322\t        else:\n323\t            data = None\n324\t            if size is not None:\n325\t                try:\n326\t                    data = fs.read_input(root, rel_disk)\n327\t                except (fs.Unknown, fs.Absent):\n328\t                    data = None\n329\t            if data is None:\n330\t                f.error = \"os\"\n331\t            else:\n332\t                f.sha = hashlib.sha256(data).hexdigest()\n333\t                try:\n334\t                    f.text = read_text_like_lint(data)\n335\t                except UnicodeDecodeError:\n336\t                    f.error = \"decode\"\n337\t        if f.error is not None:\n338\t            unreadable.append((kind, f.rel))\n339\t        if f.error == \"os\":\n340\t            transient.append((kind, f.rel))\n341\t        gen.update(f\"{kind}\\0{rel_disk}\\0{f.sha or '!' + str(f.error)}\\n\".encode(\"utf-8\"))\n342\t        inputs.append(f)\n343\t    second = input_list(root)\n344\t    if second != first:\n345\t        raise InputsChanged(\"読んでいるあいだに Wiki が変わった\")\n346\t    return Snapshot(signature=signature_of(second), inputs=inputs, generation=gen.hexdigest()[:20],\n347\t                    unreadable=unreadable, entries=second, transient=transient)\n348\t\n349\t"}]},"parent_tool_use_id":null,"session_id":"b80a7cfc-5124-475e-a5d7-29e8b293e114","uuid":"42e0c012-552a-413e-bb6a-f5395f809557","timestamp":"2026-11-17T14:50:06.727Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Works\\info-hive-dev\\.claude\\worktrees\\adr-0029-impl\\info-hive-wiki\\skills\\info-hive\\scripts\\wiki_browse_core.py","content":"    \"\"\"入力の一覧（設計の 4）。(種類, ディスク上の相対パス, 大きさ, 更新時刻) の並び。分からなければ InputsUnknown。\n\n    写しが読むものも、変化を知るための印も、比べる 2 回の走査も、この 1 つの一覧から作る。\n    \"\"\"\n    entries, problem = fs.walk_inputs(root)\n    if problem is not None:\n        raise InputsUnknown(problem)\n    return tuple(entries)\n\n\ndef signature_of(entries) -> str:\n    \"\"\"入力の印。入力の一覧の、種類、相対パス、大きさ、更新時刻から作る。\"\"\"\n    h = hashlib.sha256()\n    for kind, rel, size, mtime in entries:\n        h.update(f\"{kind}\\0{rel}\\0{size}\\0{mtime}\\n\".encode(\"utf-8\"))\n    return h.hexdigest()\n\n\ndef signature(root) -> str:\n    \"\"\"今の入力の印。名前の集合が分からなければ InputsUnknown。\"\"\"\n    return signature_of(input_list(root))\n\n\ndef read_text_like_lint(data: bytes) -> str:\n    \"\"\"lint の read_text(encoding=\"utf-8-sig\") と同じ文字にする。BOM を除き、改行を LF にそろえる。\"\"\"\n    return io.TextIOWrapper(io.BytesIO(data), encoding=\"utf-8-sig\", newline=None).read()\n\n\n@dataclass\nclass Snapshot:\n    \"\"\"写し。inputs と generation が内容、signature と unreadable が読み取りの情報である（設計の 8）。\"\"\"\n    signature: str\n    inputs: list\n    generation: str\n    unreadable: list = field(default_factory=list)   # 中身を読めなかった入力の (種類, 相対パス)（UTF-8 でないものを含む）\n    entries: tuple = ()                              # 入力の一覧（読み取りの情報。公開の前の検査が使う）\n    transient: list = field(default_factory=list)    # そのうち、開けなかった入力（ファイルを変えずに読めるようになりうる）\n\n    def by_kind(self, kind: str) -> list:\n        return [f for f in self.inputs if f.kind == kind]\n\n\n# XML 1.0 の文書に現れてよい文字（Char）の外。NUL と、タブ、改行、復帰のほかの制御文字を含む\n_XML_ILLEGAL_RE = re.compile(\"[^\\t\\n\\r\\u0020-\\ud7ff\\ue000-\\ufffd\\U00010000-\\U0010ffff]\")\n# XML の宣言。文法（XMLDecl ::= '<?xml' VersionInfo ...、VersionInfo は空白で始まる）どおり、<?xml のあとに空白が要る。\n# \\b にすると <?xml-stylesheet ...?> の処理命令を宣言と取り違える（実装の 2 回目のレビューの軽微）\n_XML_DECL_RE = re.compile(r\"\\A<\\?xml[ \\t\\r\\n](.*?)\\?>\", re.S)\n_XML_ENCODING_RE = re.compile(r\"\"\"\\bencoding\\s*=\\s*[\"']([^\"']*)[\"']\"\"\")\n\n\ndef is_utf8_svg(data: bytes) -> bool:\n    \"\"\"svg のバイト列を、XML として UTF-8 で読むなら真（図の描画の設計の 6.2）。\n\n    公開の前の検査（scan_machine_info）は UTF-8 で読むので、XML として別の符号化で読まれる svg を出力に書くと、\n    中の絶対パスとトークンを見つけられない。UTF-8 として読めるだけでは足りない。BOM のない UTF-16 の、ASCII の\n    文字だけの XML は、UTF-8 としても読めるからである（実装の 1 回目のレビューの重大）。そこで次の 3 つを求める。\n    - UTF-8（BOM はあってもよい）として読める。\n    - XML 1.0 で許される文字だけからなる。UTF-16 と UTF-32 の ASCII の文字は NUL を伴うので、ここで落ちる。\n    - 先頭の XML の宣言が、UTF-8 のほかの符号化を名乗らない。\n    \"\"\"\n    try:\n        text = data.decode(\"utf-8-sig\")\n    except UnicodeDecodeError:\n        return False\n    if _XML_ILLEGAL_RE.search(text):\n        return False\n    decl = _XML_DECL_RE.match(text)\n    if decl is None:\n        return True\n    enc = _XML_ENCODING_RE.search(decl.group(1))\n    return enc is None or enc.group(1).strip().lower() in (\"utf-8\", \"utf8\")\n\n\n_SVG_LENGTH_RE = re.compile(r\"\\s*([0-9]+(?:\\.[0-9]+)?)\\s*(?:px)?\\s*\")\n\n\nclass _RootFound(Exception):\n    \"\"\"svg_size が、根の要素の開始タグか DTD を読んだところで、解析を止める。\"\"\"\n\n\ndef _svg_root_attrs(data: bytes) -> \"dict | None\":\n    \"\"\"svg の根の要素の属性を、標準ライブラリの expat で読む。根が svg でないか、XML として読めないか、DTD が\n    あれば None。根の開始タグを読んだところで止めるので、それより後は解析しない。DTD があれば、その始まりで\n    止める（実体の定義を展開させない）。正規表現で探すと、コメントの中の <svg や data-width を拾う（実装の 1 回目の\n    レビューの軽微）。\"\"\"\n    import xml.parsers.expat\n    found = {}\n\n    def start(name, attrs):\n        found[\"name\"], found[\"attrs\"] = name, attrs\n        raise _RootFound\n\n    def doctype(*_args):\n        found[\"dtd\"] = True\n        raise _RootFound\n\n    parser = xml.parsers.expat.ParserCreate()\n    parser.StartElementHandler = start\n    parser.StartDoctypeDeclHandler = doctype\n    try:\n        parser.Parse(data, True)\n    except _RootFound:\n        pass\n    except (xml.parsers.expat.ExpatError, ValueError):\n        return None\n    name = found.get(\"name\")\n    if found.get(\"dtd\") or name is None or name.rpartition(\":\")[2] != \"svg\":\n        return None\n    return found[\"attrs\"]\n\n\ndef svg_size(data: bytes) -> \"tuple | None\":\n    \"\"\"svg の根の要素の width と height（なければ viewBox）から、表示の大きさ (幅, 高さ) を整数で返す。\n\n    分からなければ None。<img> の width と height の属性にして、読み込む前から入れ物の幅を決める（WebKit は、幅を\n    中身で決める入れ物の中の画像を、読み込んだあとに組み直さない）。単位は px か、単位なしだけを読む。\n    \"\"\"\n    if not is_utf8_svg(data):\n        return None\n    attrs = _svg_root_attrs(data)\n    if attrs is None:\n        return None\n    w = _SVG_LENGTH_RE.fullmatch(attrs.get(\"width\", \"\"))\n    h = _SVG_LENGTH_RE.fullmatch(attrs.get(\"height\", \"\"))\n    if w and h:\n        size = (float(w.group(1)), float(h.group(1)))\n    else:\n        parts = re.split(r\"[\\s,]+\", attrs.get(\"viewBox\", \"\").strip())\n        try:\n            nums = [float(p) for p in parts] if len(parts) == 4 else []\n        except ValueError:\n            nums = []\n        if not nums:\n            return None\n        size = (nums[2], nums[3])\n    if not all(0 < v <= 20000 for v in size):\n        return None\n    return round(size[0]) or 1, round(size[1]) or 1\n\n\ndef _read_asset(root, f: InputFile, size) -> None:\n    \"\"\"図の svg を読み、f の data、sha、error を決める。上限は読む口が強制する（図の描画の設計の 6.2）。\"\"\"\n    if size is None:\n        f.error = \"os\"\n        return\n    if size > ASSET_MAX_BYTES:\n        f.error = \"too_large\"\n        return\n    try:\n        data = fs.read_input_capped(root, f.disk_rel, ASSET_MAX_BYTES)\n    except fs.TooLarge:\n        f.error = \"too_large\"\n        return\n    except (fs.Unknown, fs.Absent):\n        f.error = \"os\"\n        return\n    f.sha = hashlib.sha256(data).hexdigest()\n    if not is_utf8_svg(data):\n        f.error = \"decode\"\n        return\n    f.data = data\n\n\ndef take_snapshot(root, entries=None) -> Snapshot:\n    \"\"\"入力の一覧を作り、入力を読み、もう 1 度一覧を作る。2 回が同じときだけ、写しを採る（設計の 4.2）。\n\n    違えば InputsChanged、名前の集合が分からなければ InputsUnknown。中身を読めない入力は、その入力がない Wiki と\n    同じに描き、読み取りの印を足す（設計の 4.1）。\n    \"\"\"\n    first = input_list(root) if entries is None else tuple(entries)\n    inputs = []\n    unreadable = []\n    transient = []\n    gen = hashlib.sha256(CORE_VERSION.encode(\"utf-8\"))\n    for kind, rel_disk, size, _mtime in first:\n        if kind == \"link\":\n            # リンクなので読まない（ADR-0029）。読まないことも内容なので、世代に入れる\n            gen.update(f\"link\\0{rel_disk}\\0{_mtime}\\n\".encode(\"utf-8\"))\n            continue\n        f = InputFile(kind=kind, disk_rel=rel_disk, rel=posix_rel(rel_disk))\n        if kind in (\"asset\", \"asset_dir\"):\n            _read_asset(root, f, size)     # asset_dir（assets/ の一覧を作れない）は大きさがなく、読めない入力になる\n        else:\n            data = None\n            if size is not None:\n                try:\n                    data = fs.read_input(root, rel_disk)\n                except (fs.Unknown, fs.Absent):\n                    data = None\n            if data is None:\n                f.error = \"os\"\n            else:\n                f.sha = hashlib.sha256(data).hexdigest()\n                try:\n                    f.text = read_text_like_lint(data)\n                except UnicodeDecodeError:\n                    f.error = \"decode\"\n        if f.error is not None:\n            unreadable.append((kind, f.rel))\n        if f.error == \"os\":\n            transient.append((kind, f.rel))\n        gen.update(f\"{kind}\\0{rel_disk}\\0{f.sha or '!' + str(f.error)}\\n\".encode(\"utf-8\"))\n        inputs.append(f)\n    second = input_list(root)\n    if second != first:\n        raise InputsChanged(\"読んでいるあいだに Wiki が変わった\")\n    return Snapshot(signature=signature_of(second), inputs=inputs, generation=gen.hexdigest()[:20],\n                    unreadable=unreadable, entries=second, transient=transient)\n\n","numLines":210,"startLine":140,"totalLines":1967}},"tool_result_meta":[{"id":"toolu_01SDYDi8wkCvsQ5porY8aaCU","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
