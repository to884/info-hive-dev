ssertEqual(wiki_pages.walk_assets(self.wiki).files, [])\n+        self.assertEqual([os.fspath(c.args[0]) for c in listing.call_args_list], [str(self.wiki)])\n+\n+    def test_unverified_assets_directory_is_reported(self):\n+        self.write(\"assets/a.svg\", \"<svg/>\")\n+        with mock.patch.object(wiki_pages, \"_stat_entry\", return_value=(\"denied\", None)):\n+            found = wiki_pages.walk_assets(self.wiki)\n+        self.assertEqual((found.files, found.unknown), ([], [\"assets\"]))\n+\n+\n class LinkKindTests(Base):\n     def test_kinds(self):\n         a = self.write(\"a.md\", \"a\")\n@@ -1038,6 +1063,7 @@ class ReadSiteInventoryTests(unittest.TestCase):\n     URL = \"ファイルではなく URL を開く\"\n \n     SITES = {\n+        (\"wiki_codex.py\", \"workflow\"): NOT_ARTICLE,  # 同梱の commands/*.md。wiki の記事ではない\n         (\"init_wiki.py\", \"copy_template\"): NOT_ARTICLE,\n         (\"init_wiki.py\", \"detect_schema_gaps\"): GATEWAY,\n         (\"wiki_browse_fs.py\", \"_check_marker\"): NOT_ARTICLE,\ndiff --git a/skills/info-hive/scripts/wiki_pages.py b/skills/info-hive/scripts/wiki_pages.py\nindex c1ed7ad..6ed65b8 100644\n--- a/skills/info-hive/scripts/wiki_pages.py\n+++ b/skills/info-hive/scripts/wiki_pages.py\n@@ -647,9 +647,10 @@ def walk_assets(wiki_root) -> Walk:\n       下位のディレクトリには降りない。\n     - 守るのは、走査の時点で木に置かれたリンクである。読む間だけリンクに替えて戻す同時の書き手は対象にしない\n       （図の描画の設計の 6.1）。\n-    OS の呼び出しは、walk_markdown と同じ口（_list_dir、DirEntry の is_symlink と is_dir、_is_junction、\n-    _stat_entry）だけを使う。\n+    OS の呼び出しは、walk_markdown と同じ口（_list_dir、_stat_entry）だけを使う。\n+    リンクの種類は wiki_links.link_kind で決め、記事と違ってハードリンクは拒まない。\n     \"\"\"\n+    import wiki_links\n     root = os.fspath(wiki_root)\n     files, unlistable, unknown = [], [], []\n     state, entries = read_os(_list_dir, root)\n@@ -658,19 +659,15 @@ def walk_assets(wiki_root) -> Walk:\n     top = next((e for e in entries or [] if e.name == ASSETS_DIR), None)\n     if top is None:\n         return Walk([], [], [])\n-    sta