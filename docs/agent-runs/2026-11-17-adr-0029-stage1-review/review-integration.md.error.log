y\n@@ -312,6 +312,10 @@ def take_snapshot(root, entries=None) -> Snapshot:\n     transient = []\n     gen = hashlib.sha256(CORE_VERSION.encode(\"utf-8\"))\n     for kind, rel_disk, size, _mtime in first:\n+        if kind == \"link\":\n+            # リンクなので読まない（ADR-0029）。読まないことも内容なので、世代に入れる\n+            gen.update(f\"link\\0{rel_disk}\\0{_mtime}\\n\".encode(\"utf-8\"))\n+            continue\n         f = InputFile(kind=kind, disk_rel=rel_disk, rel=posix_rel(rel_disk))\n         if kind in (\"asset\", \"asset_dir\"):\n             _read_asset(root, f, size)     # asset_dir（assets/ の一覧を作れない）は大きさがなく、読めない入力になる\n@@ -805,6 +809,10 @@ class Core:\n         self._render_lock = threading.Lock()\n         self._build_pages()\n         self._build_assets()\n+        # 走査がリンクなので読まなかった記事と記事までの道（ADR-0029）。黙って消さず、診断に出す\n+        for kind, rel, _size, link_kind in snapshot.entries:\n+            if kind == \"link\":\n+                self.diagnostics.append({\"kind\": \"link\", \"path\": rel, \"link_kind\": link_kind})\n         self.out_name = assign_names(sorted(self.drawn), name_limit)\n         self.name_to_id = {name: pid for pid, name in self.out_name.items()}\n         for pid in sorted(self.drawn):\ndiff --git a/skills/info-hive/scripts/wiki_browse_fs.py b/skills/info-hive/scripts/wiki_browse_fs.py\nindex eb910d5..b7cc711 100644\n--- a/skills/info-hive/scripts/wiki_browse_fs.py\n+++ b/skills/info-hive/scripts/wiki_browse_fs.py\n@@ -1435,7 +1435,8 @@ def remove_record(root, browse_root, state_dir, owner, instance) -> None:\n def walk_inputs(root):\n     \"\"\"入力の一覧（設計の 4）。(entries, problem) を返す。\n \n-    entries は (種類, ディスク上の / 区切りの相対パス, 大きさ, 更新時刻) の並びで、ページ、索引、オントロジーの順。\n+    entries は (種類, ディスク上の / 区切りの相対パス, 大きさ, 更新時刻) の並びで、ページ、索引、リンク、オントロジーの順。\n+    リンク（種類 \"link\"）は、走査がリンクなので読まなかった記事と記事までの道で、大きさは None、4 つ目はリンクの種類である。\n     ページと索引の集合は、lint と同じ走査の関数（wiki_pages.walk_pages、walk_index_files）が決める。オントロジーは、\n     層の stat で種類、大きさ、更新時刻を得る（ないなら入れない。調べられなければ、大きさと更新時刻を None にする）。\n 