{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012YWU6gHb2jE3418TQvCMKc","type":"tool_result","content":"280\t                raise NoFileId(None, ctypes.FormatError(code).strip(), path, code)\n281\t            raise error()\n282\t        return info.VolumeSerialNumber, bytes(info.FileId)\n283\t    finally:\n284\t        if not k.CloseHandle(handle):\n285\t            raise error()\n286\t\n287\t\n288\tdef _sort_key(rel: str) -> \"tuple[str, str]\":\n289\t    \"\"\"並びの鍵。今の iter_page_files() の鍵（posix_rel）に、同じ鍵のときの決め方（ディスク上の綴り）を足したもの。\"\"\"\n290\t    return (posix_rel(rel), rel)\n291\t\n292\t\n293\tdef _stat_entry(path: str):\n294\t    \"\"\"(状態, stat の結果)。.md の項目と、最上位の記事（index.md、log.md、SCHEMA.md）を調べる os.lstat()。\n295\t\n296\t    リンクをたどらない。リンクかどうか（wiki_links.link_kind）と、ふつうのファイルかどうかと、ハードリンクの\n297\t    リンクの数（st_nlink。Windows の DirEntry.stat() ではいつも 0 なので、この呼び出しでしか分からない）を、\n298\t    1 回の呼び出しで決める。\n299\t\n300\t    Windows の os.lstat() は、属性の取得がエラー 1、50、87 で失敗すると、S_IFBLK の成功に読み替える。一覧に載る項目が\n301\t    ボリュームや物理ディスクであることはないので、Windows で S_IFBLK が返ったら「分からない」にする。POSIX の S_IFBLK は\n302\t    本物のデバイスのファイルなので、ふつうのファイルでない（今と同じ）。\n303\t    \"\"\"\n304\t    state, st = read_os(os.lstat, path)\n305\t    if state == \"ok\" and NT and stat.S_ISBLK(st.st_mode):\n306\t        return \"denied\", None\n307\t    return state, st\n308\t\n309\t\n310\tdef _list_dir(directory: str) -> list:\n311\t    # 項目を最後まで取り出してから閉じる。閉じるときの失敗は、CPython が捨てる（ScandirIterator_closedir が FindClose と\n312\t    # closedir の戻り値を見ない）が、取り出し終えた一覧は変わらない。\n313\t    with os.scandir(directory) as it:\n314\t        return list(it)\n315\t\n316\t\n317\tdef _entry_lstat(entry):\n318\t    \"\"\"(状態, stat の結果)。一覧の項目の、リンクをたどらない属性。Windows では一覧の情報（再解析のタグと属性）から\n319\t    答え、OS を呼ばない。POSIX では lstat を 1 回呼ぶ。st_nlink は使わない（Windows では 0 になる）。\"\"\"\n320\t    return read_os(entry.stat, follow_symlinks=False)\n321\t\n322\t\n323\tdef _link_is_dir(entry, est):\n324\t    \"\"\"(状態, ディレクトリへのリンクか)。Windows では属性の FILE_ATTRIBUTE_DIRECTORY で決め、OS を呼ばない（ジャンクションと\n325\t    ディレクトリのシンボリックリンクに立つ）。POSIX では、リンクの先をたどる is_dir() を呼ぶ。\"\"\"\n326\t    if NT:\n327\t        return \"ok\", bool((getattr(est, \"st_file_attributes\", 0) or 0) & 0x10)\n328\t    return read_os(entry.is_dir)\n329\t\n330\t\n331\tdef walk_markdown(start, prefix: str = \"\", skip_top: bool = False, visited: \"list | None\" = None) -> Walk:\n332\t    \"\"\"start の下をたどり、名前が .md で終わるふつうのファイルと、拒んだリンクと、知らせを返す（ADR-0029）。\n333\t\n334\t    - 起点には、リンクであっても降りる（根と祖先のリンクは許す）。\n335\t    - 起点の下の、名前が . で始まる項目には、どの深さでも、どの呼び出しもしない（記事でない）。\n336\t    - skip_top が真なら、起点の直下の、名前が SKIP_TOP_LEVEL_DIRS に入っている項目には、どの呼び出しもしない。\n337\t    - リンク（wiki_links.link_kind が種類を返すもの）には降りず、読まない。ディレクトリへのリンクと、名前が .md で\n338\t      終わるもののリンクは、links に (相対パス, 種類) で入れる。名前が .md で終わらないファイルのリンクは、記事で\n339\t      ないので入れない。ハードリンク（リンクの数が 2 以上）の .md も、読まずに links に入れる。\n340\t    - prefix は、返す相対パスの先頭に付ける。並びは posix_rel の順、同じなら綴りの順である。\n341\t    - visited にリストを渡すと、一覧を作れたディレクトリの相対パス（起点は prefix から末尾の / を除いたもの。\n342\t      prefix が空なら \"\"）を足す。この一覧が降りる場所かを、規則を写さずに確かめるためのもの（YouTube の字幕の\n343\t      照合が、用意したページの場所を確かめるのに使う）。\n344\t    \"\"\"\n345\t    files, unlistable, unknown, links = [], [], [], []\n346\t    start = os.fspath(start)\n347\t    stack = [(start, prefix)]\n348\t    while stack:\n349\t        directory, pre = stack.pop()\n350\t        if pre != prefix:\n351\t            # 一覧で見たあと、降りる前に、ディレクトリがリンクに替わっていないかを確かめる（起点は、リンクでも降りる）\n352\t            state, dst = _stat_entry(directory)\n353\t            if state == \"absent\":\n354\t                continue\n355\t            if state == \"denied\":\n356\t                unknown.append(pre.rstrip(\"/\"))\n357\t                continue\n358\t            kind = link_kind(dst)\n359\t            if kind is not None:\n360\t                links.append((pre.rstrip(\"/\"), kind))\n361\t                continue\n362\t            if not stat.S_ISDIR(dst.st_mode):\n363\t                continue\n364\t        state, entries = read_os(_list_dir, directory)\n365\t        if state == \"absent\":\n366\t            continue\n367\t        if state == \"denied\":\n368\t            unlistable.append(pre.rstrip(\"/\") or \".\")\n369\t            continue\n370\t        if visited is not None:\n371\t            visited.append(pre.rstrip(\"/\"))\n372\t        for entry in entries:\n373\t            name = entry.name\n374\t            rel = pre + name\n375\t            if skip_top and pre == prefix and name in SKIP_TOP_LEVEL_DIRS:\n376\t                continue  # 名前だけで決める。リンクかどうかも、ディレクトリかどうかも調べない\n377\t            if name.startswith(\".\"):\n378\t                continue  # 名前が . で始まる項目は、どの深さでも記事でない。どの呼び出しもしない\n379\t            state, est = _entry_lstat(entry)\n380\t            if state == \"absent\":\n381\t                continue\n382\t            if state == \"denied\":\n383\t                unknown.append(rel)\n384\t                continue\n385\t            kind = link_kind(est, nlink_known=False)\n386\t            if kind is not None:\n387\t                # 名前が .md で終わるリンクは、記事のリンクとして入れる。ただし起点の直下の README.md は記事でない\n388\t                # ので、ディレクトリへのリンク（記事までの道）のときだけ入れる（下の判定に回す）\n389\t                if name.lower().endswith(\".md\") and not (skip_top and pre == prefix and name == \"README.md\"):\n390\t                    links.append((rel, kind))\n391\t                    continue\n392\t                state, is_dir = _link_is_dir(entry, est)\n393\t                if state == \"denied\":\n394\t                    unknown.append(rel)\n395\t                elif state == \"ok\" and is_dir:\n396\t                    links.append((rel, kind))  # ディレクトリへのリンク。降りない\n397\t                continue  # .md でないファイルのリンクと、先のないリンクは、記事でない\n398\t            if stat.S_ISDIR(est.st_mode):\n399\t                stack.append((entry.path, rel + \"/\"))\n400\t                continue\n401\t            if name.lower().endswith(\".md\"):\n402\t                state, st = _stat_entry(entry.path)\n403\t                if state == \"absent\":\n404\t                    continue\n405\t                if state == \"denied\":\n406\t                    unknown.append(rel)\n407\t                    continue\n408\t                kind = link_kind(st)\n409\t                if kind is not None:\n410\t                    if kind == \"hardlink\" and skip_top and pre == prefix and name == \"README.md\":\n411\t                        continue  # 起点の直下の README.md は記事でない（ふつうのファイルのハードリンクは道でもない）\n412\t                    links.append((rel, kind))  # ハードリンク（一覧と lstat の間に置き換えられたリンクも）\n413\t                elif stat.S_ISREG(st.st_mode):\n414\t                    files.append(MdFile(rel, st.st_size, st.st_mtime_ns))\n415\t    files.sort(key=lambda f: _sort_key(f.rel))\n416\t    links.sort(key=lambda item: _sort_key(item[0]))\n417\t    for rel, kind in links:\n418\t        _notice(rel, kind)\n419\t    for rel in unknown:\n420\t        _notice(rel, \"unknown\")\n421\t    for rel in unlistable:\n422\t        _notice(rel, \"unlistable\")\n423\t    return Walk(files, sorted(unlistable, key=_sort_key), sorted(unknown, key=_sort_key), links)\n424\t\n425\t\n426\tdef walk_pages(wiki_root, visited: \"list | None\" = None) -> Walk:\n427\t    \"\"\"ページのファイルと、知らせ。知らせは、たどった全体のものをそのまま返す。visited は walk_markdown と同じ。\n428\t\n429\t    links は、走査が拒んだものをそのまま返す（最上位の index.md、log.md、SCHEMA.md のリンクも入る。どの記事の\n430\t    リンクを入れるかは walk_markdown の 1 か所で決め、使う側で絞らない）。\n431\t    \"\"\"\n432\t    found = walk_markdown(wiki_root, skip_top=True, visited=visited)\n433\t    return Walk([f for f in found.files if is_page_path(f.rel, native=True)], found.unlistable, found.unknown, found.links)\n434\t\n435\t\n436\tdef walk_index_files(wiki_root) -> Walk:\n437\t    \"\"\"索引のファイル（最上位の index.md と、indexes を起点にした .md）と、拒んだリンクと、知らせ。\n438\t\n439\t    最上位の index.md と indexes そのものがリンクなら、読まず、降りず、links に入れる（ADR-0029。indexes は記事までの道）。\n440\t    \"\"\"\n441\t    root = os.fspath(wiki_root)\n442\t    files, unknown, links = [], [], []\n443\t    state, st = _stat_entry(os.path.join(root, \"index.md\"))\n444\t    if state == \"denied\":\n445\t        unknown.append(\"index.md\")\n446\t        _notice(\"index.md\", \"unknown\")\n447\t    elif state == \"ok\":\n448\t        kind = link_kind(st)\n449\t        if kind is not None:\n450\t            links.append((\"index.md\", kind))\n451\t            _notice(\"index.md\", kind)\n452\t        elif stat.S_ISREG(st.st_mode):\n453\t            files.append(MdFile(\"index.md\", st.st_size, st.st_mtime_ns))\n454\t    state, ist = _stat_entry(os.path.join(root, \"indexes\"))\n455\t    if state == \"denied\":\n456\t        _notice(\"indexes\", \"unknown\")\n457\t        return Walk(files, [], unknown + [\"indexes\"], links)\n458\t    if state == \"absent\":\n459\t        return Walk(files, [], unknown, links)\n460\t    kind = link_kind(ist)\n461\t    if kind is not None and kind != \"hardlink\":  # ふつうのファイルのハードリンクは、記事でも記事までの道でもない\n462\t        _notice(\"indexes\", kind)\n463\t        return Walk(files, [], unknown, links + [(\"indexes\", kind)])\n464\t    below = walk_markdown(os.path.join(root, \"indexes\"), prefix=\"indexes/\")\n465\t    return Walk(files + below.files, below.unlistable, unknown + below.unknown, links + below.links)\n466\t\n467\t\n468\tTOP_ARTICLES = (\"index.md\", \"log.md\", \"SCHEMA.md\")\n469\t\n470\t\n471\tdef is_article_path(rel: \"str | PurePosixPath\", *, native: bool = False) -> bool:\n472\t    \"\"\"wiki のルートからの相対パス（/ 区切り）が、wiki の側の記事かを、名前の規則だけで返す（ADR-0029 の作者の決定の 6）。\n473\t\n474\t    記事は、ページ（is_page_path）と、最上位の index.md、log.md、SCHEMA.md と、indexes の下の .md（どの要素も名前が\n475\t    . で始まらないもの）である。リンクかどうかは定義に入れない。raw の記事は、source ページの raw: で決まる。\n476\t    \"\"\"\n477\t    parts = PurePosixPath(_relative_text(rel, native)).parts\n478\t    if not parts or any(part.startswith(\".\") for part in parts):\n479\t        return False\n480\t    if len(parts) == 1 and parts[0] in TOP_ARTICLES:\n481\t        return True\n482\t    if parts[0] == \"indexes\" and len(parts) > 1:\n483\t        return parts[-1].lower().endswith(\".md\")\n484\t    return is_page_path(rel, native=native)\n485\t\n486\t\n487\tclass ArticlePath(NamedTuple):\n488\t    \"\"\"記事を読む口の結果。state は \"ok\"、\"absent\"（ない、ふつうのファイルでない）、\"denied\"（分からない）、\n489\t    \"link\"（記事か記事までの道がリンク。link に (相対パス, 種類)）、\"not_article\"（名前の規則で記事でない）。\"\"\"\n490\t    state: str\n491\t    path: \"Path | None\" = None\n492\t    link: \"tuple | None\" = None\n493\t\n494\t\n495\tdef article_path(wiki_root, rel, *, directory: bool = False, native: bool = False) -> ArticlePath:\n496\t    \"\"\"記事を読む口（ADR-0029 の I2、I4）。根から rel までの道と rel そのものに、走査と同じ判定を当てる。\n497\t\n498\t    根そのものと、その祖先のリンクは許す。rel の要素ごとに os.lstat() を呼び、リンクに当たれば読まずに \"link\" を返す。\n499\t    directory が真なら、記事を含みうるディレクトリまでの道を検査する。\n500\t    native が真なら、POSIX のファイル名に含まれるバックスラッシュを区切りに変えない。\n501\t    呼ぶ側は、\"ok\" のときだけ path を読むか降りる。拒んだことを「ない」に変えない。\n502\t    \"\"\"\n503\t    rel = _relative_text(rel, native)\n504\t    if directory and not rel:\n505\t        return ArticlePath(\"ok\", Path(wiki_root))  # 起点そのもののリンクは許す\n506\t    parts = rel.split(\"/\")\n507\t    # 根の外へ出る名前（絶対パス、ドライブ、..、空の要素）は、記事の名前ではない\n508\t    if rel.startswith(\"/\") or any(part in (\"\", \".\", \"..\") or (NT and \":\" in part) for part in parts):\n509\t        return ArticlePath(\"not_article\")\n510\t    if not is_article_path(rel + \"/article.md\" if directory else rel, native=native):\n511\t        return ArticlePath(\"not_article\")\n512\t    current = os.fspath(wiki_root)\n513\t    st = None\n514\t    for i, part in enumerate(parts):\n515\t        current = os.path.join(current, part)\n516\t        state, st = _stat_entry(current)\n517\t        if state == \"denied\":\n518\t            _notice(\"/\".join(parts[:i + 1]), \"unknown\")\n519\t        if state != \"ok\":\n520\t            return ArticlePath(state)\n521\t        kind = link_kind(st)\n522\t        if kind is not None:\n523\t            _notice(\"/\".join(parts[:i + 1]), kind)\n524\t            return ArticlePath(\"link\", link=(\"/\".join(parts[:i + 1]), kind))\n525\t    if not (stat.S_ISDIR(st.st_mode) if directory else stat.S_ISREG(st.st_mode)):\n526\t        return ArticlePath(\"absent\")\n527\t    return ArticlePath(\"ok\", Path(current))\n528\t\n529\t"}]},"parent_tool_use_id":null,"session_id":"b80a7cfc-5124-475e-a5d7-29e8b293e114","uuid":"cfd13e1c-af47-4d2e-ae9c-d9797be55862","timestamp":"2026-11-17T14:51:23.576Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Works\\info-hive-dev\\.claude\\worktrees\\adr-0029-impl\\info-hive-wiki\\skills\\info-hive\\scripts\\wiki_pages.py","content":"                raise NoFileId(None, ctypes.FormatError(code).strip(), path, code)\n            raise error()\n        return info.VolumeSerialNumber, bytes(info.FileId)\n    finally:\n        if not k.CloseHandle(handle):\n            raise error()\n\n\ndef _sort_key(rel: str) -> \"tuple[str, str]\":\n    \"\"\"並びの鍵。今の iter_page_files() の鍵（posix_rel）に、同じ鍵のときの決め方（ディスク上の綴り）を足したもの。\"\"\"\n    return (posix_rel(rel), rel)\n\n\ndef _stat_entry(path: str):\n    \"\"\"(状態, stat の結果)。.md の項目と、最上位の記事（index.md、log.md、SCHEMA.md）を調べる os.lstat()。\n\n    リンクをたどらない。リンクかどうか（wiki_links.link_kind）と、ふつうのファイルかどうかと、ハードリンクの\n    リンクの数（st_nlink。Windows の DirEntry.stat() ではいつも 0 なので、この呼び出しでしか分からない）を、\n    1 回の呼び出しで決める。\n\n    Windows の os.lstat() は、属性の取得がエラー 1、50、87 で失敗すると、S_IFBLK の成功に読み替える。一覧に載る項目が\n    ボリュームや物理ディスクであることはないので、Windows で S_IFBLK が返ったら「分からない」にする。POSIX の S_IFBLK は\n    本物のデバイスのファイルなので、ふつうのファイルでない（今と同じ）。\n    \"\"\"\n    state, st = read_os(os.lstat, path)\n    if state == \"ok\" and NT and stat.S_ISBLK(st.st_mode):\n        return \"denied\", None\n    return state, st\n\n\ndef _list_dir(directory: str) -> list:\n    # 項目を最後まで取り出してから閉じる。閉じるときの失敗は、CPython が捨てる（ScandirIterator_closedir が FindClose と\n    # closedir の戻り値を見ない）が、取り出し終えた一覧は変わらない。\n    with os.scandir(directory) as it:\n        return list(it)\n\n\ndef _entry_lstat(entry):\n    \"\"\"(状態, stat の結果)。一覧の項目の、リンクをたどらない属性。Windows では一覧の情報（再解析のタグと属性）から\n    答え、OS を呼ばない。POSIX では lstat を 1 回呼ぶ。st_nlink は使わない（Windows では 0 になる）。\"\"\"\n    return read_os(entry.stat, follow_symlinks=False)\n\n\ndef _link_is_dir(entry, est):\n    \"\"\"(状態, ディレクトリへのリンクか)。Windows では属性の FILE_ATTRIBUTE_DIRECTORY で決め、OS を呼ばない（ジャンクションと\n    ディレクトリのシンボリックリンクに立つ）。POSIX では、リンクの先をたどる is_dir() を呼ぶ。\"\"\"\n    if NT:\n        return \"ok\", bool((getattr(est, \"st_file_attributes\", 0) or 0) & 0x10)\n    return read_os(entry.is_dir)\n\n\ndef walk_markdown(start, prefix: str = \"\", skip_top: bool = False, visited: \"list | None\" = None) -> Walk:\n    \"\"\"start の下をたどり、名前が .md で終わるふつうのファイルと、拒んだリンクと、知らせを返す（ADR-0029）。\n\n    - 起点には、リンクであっても降りる（根と祖先のリンクは許す）。\n    - 起点の下の、名前が . で始まる項目には、どの深さでも、どの呼び出しもしない（記事でない）。\n    - skip_top が真なら、起点の直下の、名前が SKIP_TOP_LEVEL_DIRS に入っている項目には、どの呼び出しもしない。\n    - リンク（wiki_links.link_kind が種類を返すもの）には降りず、読まない。ディレクトリへのリンクと、名前が .md で\n      終わるもののリンクは、links に (相対パス, 種類) で入れる。名前が .md で終わらないファイルのリンクは、記事で\n      ないので入れない。ハードリンク（リンクの数が 2 以上）の .md も、読まずに links に入れる。\n    - prefix は、返す相対パスの先頭に付ける。並びは posix_rel の順、同じなら綴りの順である。\n    - visited にリストを渡すと、一覧を作れたディレクトリの相対パス（起点は prefix から末尾の / を除いたもの。\n      prefix が空なら \"\"）を足す。この一覧が降りる場所かを、規則を写さずに確かめるためのもの（YouTube の字幕の\n      照合が、用意したページの場所を確かめるのに使う）。\n    \"\"\"\n    files, unlistable, unknown, links = [], [], [], []\n    start = os.fspath(start)\n    stack = [(start, prefix)]\n    while stack:\n        directory, pre = stack.pop()\n        if pre != prefix:\n            # 一覧で見たあと、降りる前に、ディレクトリがリンクに替わっていないかを確かめる（起点は、リンクでも降りる）\n            state, dst = _stat_entry(directory)\n            if state == \"absent\":\n                continue\n            if state == \"denied\":\n                unknown.append(pre.rstrip(\"/\"))\n                continue\n            kind = link_kind(dst)\n            if kind is not None:\n                links.append((pre.rstrip(\"/\"), kind))\n                continue\n            if not stat.S_ISDIR(dst.st_mode):\n                continue\n        state, entries = read_os(_list_dir, directory)\n        if state == \"absent\":\n            continue\n        if state == \"denied\":\n            unlistable.append(pre.rstrip(\"/\") or \".\")\n            continue\n        if visited is not None:\n            visited.append(pre.rstrip(\"/\"))\n        for entry in entries:\n            name = entry.name\n            rel = pre + name\n            if skip_top and pre == prefix and name in SKIP_TOP_LEVEL_DIRS:\n                continue  # 名前だけで決める。リンクかどうかも、ディレクトリかどうかも調べない\n            if name.startswith(\".\"):\n                continue  # 名前が . で始まる項目は、どの深さでも記事でない。どの呼び出しもしない\n            state, est = _entry_lstat(entry)\n            if state == \"absent\":\n                continue\n            if state == \"denied\":\n                unknown.append(rel)\n                continue\n            kind = link_kind(est, nlink_known=False)\n            if kind is not None:\n                # 名前が .md で終わるリンクは、記事のリンクとして入れる。ただし起点の直下の README.md は記事でない\n                # ので、ディレクトリへのリンク（記事までの道）のときだけ入れる（下の判定に回す）\n                if name.lower().endswith(\".md\") and not (skip_top and pre == prefix and name == \"README.md\"):\n                    links.append((rel, kind))\n                    continue\n                state, is_dir = _link_is_dir(entry, est)\n                if state == \"denied\":\n                    unknown.append(rel)\n                elif state == \"ok\" and is_dir:\n                    links.append((rel, kind))  # ディレクトリへのリンク。降りない\n                continue  # .md でないファイルのリンクと、先のないリンクは、記事でない\n            if stat.S_ISDIR(est.st_mode):\n                stack.append((entry.path, rel + \"/\"))\n                continue\n            if name.lower().endswith(\".md\"):\n                state, st = _stat_entry(entry.path)\n                if state == \"absent\":\n                    continue\n                if state == \"denied\":\n                    unknown.append(rel)\n                    continue\n                kind = link_kind(st)\n                if kind is not None:\n                    if kind == \"hardlink\" and skip_top and pre == prefix and name == \"README.md\":\n                        continue  # 起点の直下の README.md は記事でない（ふつうのファイルのハードリンクは道でもない）\n                    links.append((rel, kind))  # ハードリンク（一覧と lstat の間に置き換えられたリンクも）\n                elif stat.S_ISREG(st.st_mode):\n                    files.append(MdFile(rel, st.st_size, st.st_mtime_ns))\n    files.sort(key=lambda f: _sort_key(f.rel))\n    links.sort(key=lambda item: _sort_key(item[0]))\n    for rel, kind in links:\n        _notice(rel, kind)\n    for rel in unknown:\n        _notice(rel, \"unknown\")\n    for rel in unlistable:\n        _notice(rel, \"unlistable\")\n    return Walk(files, sorted(unlistable, key=_sort_key), sorted(unknown, key=_sort_key), links)\n\n\ndef walk_pages(wiki_root, visited: \"list | None\" = None) -> Walk:\n    \"\"\"ページのファイルと、知らせ。知らせは、たどった全体のものをそのまま返す。visited は walk_markdown と同じ。\n\n    links は、走査が拒んだものをそのまま返す（最上位の index.md、log.md、SCHEMA.md のリンクも入る。どの記事の\n    リンクを入れるかは walk_markdown の 1 か所で決め、使う側で絞らない）。\n    \"\"\"\n    found = walk_markdown(wiki_root, skip_top=True, visited=visited)\n    return Walk([f for f in found.files if is_page_path(f.rel, native=True)], found.unlistable, found.unknown, found.links)\n\n\ndef walk_index_files(wiki_root) -> Walk:\n    \"\"\"索引のファイル（最上位の index.md と、indexes を起点にした .md）と、拒んだリンクと、知らせ。\n\n    最上位の index.md と indexes そのものがリンクなら、読まず、降りず、links に入れる（ADR-0029。indexes は記事までの道）。\n    \"\"\"\n    root = os.fspath(wiki_root)\n    files, unknown, links = [], [], []\n    state, st = _stat_entry(os.path.join(root, \"index.md\"))\n    if state == \"denied\":\n        unknown.append(\"index.md\")\n        _notice(\"index.md\", \"unknown\")\n    elif state == \"ok\":\n        kind = link_kind(st)\n        if kind is not None:\n            links.append((\"index.md\", kind))\n            _notice(\"index.md\", kind)\n        elif stat.S_ISREG(st.st_mode):\n            files.append(MdFile(\"index.md\", st.st_size, st.st_mtime_ns))\n    state, ist = _stat_entry(os.path.join(root, \"indexes\"))\n    if state == \"denied\":\n        _notice(\"indexes\", \"unknown\")\n        return Walk(files, [], unknown + [\"indexes\"], links)\n    if state == \"absent\":\n        return Walk(files, [], unknown, links)\n    kind = link_kind(ist)\n    if kind is not None and kind != \"hardlink\":  # ふつうのファイルのハードリンクは、記事でも記事までの道でもない\n        _notice(\"indexes\", kind)\n        return Walk(files, [], unknown, links + [(\"indexes\", kind)])\n    below = walk_markdown(os.path.join(root, \"indexes\"), prefix=\"indexes/\")\n    return Walk(files + below.files, below.unlistable, unknown + below.unknown, links + below.links)\n\n\nTOP_ARTICLES = (\"index.md\", \"log.md\", \"SCHEMA.md\")\n\n\ndef is_article_path(rel: \"str | PurePosixPath\", *, native: bool = False) -> bool:\n    \"\"\"wiki のルートからの相対パス（/ 区切り）が、wiki の側の記事かを、名前の規則だけで返す（ADR-0029 の作者の決定の 6）。\n\n    記事は、ページ（is_page_path）と、最上位の index.md、log.md、SCHEMA.md と、indexes の下の .md（どの要素も名前が\n    . で始まらないもの）である。リンクかどうかは定義に入れない。raw の記事は、source ページの raw: で決まる。\n    \"\"\"\n    parts = PurePosixPath(_relative_text(rel, native)).parts\n    if not parts or any(part.startswith(\".\") for part in parts):\n        return False\n    if len(parts) == 1 and parts[0] in TOP_ARTICLES:\n        return True\n    if parts[0] == \"indexes\" and len(parts) > 1:\n        return parts[-1].lower().endswith(\".md\")\n    return is_page_path(rel, native=native)\n\n\nclass ArticlePath(NamedTuple):\n    \"\"\"記事を読む口の結果。state は \"ok\"、\"absent\"（ない、ふつうのファイルでない）、\"denied\"（分からない）、\n    \"link\"（記事か記事までの道がリンク。link に (相対パス, 種類)）、\"not_article\"（名前の規則で記事でない）。\"\"\"\n    state: str\n    path: \"Path | None\" = None\n    link: \"tuple | None\" = None\n\n\ndef article_path(wiki_root, rel, *, directory: bool = False, native: bool = False) -> ArticlePath:\n    \"\"\"記事を読む口（ADR-0029 の I2、I4）。根から rel までの道と rel そのものに、走査と同じ判定を当てる。\n\n    根そのものと、その祖先のリンクは許す。rel の要素ごとに os.lstat() を呼び、リンクに当たれば読まずに \"link\" を返す。\n    directory が真なら、記事を含みうるディレクトリまでの道を検査する。\n    native が真なら、POSIX のファイル名に含まれるバックスラッシュを区切りに変えない。\n    呼ぶ側は、\"ok\" のときだけ path を読むか降りる。拒んだことを「ない」に変えない。\n    \"\"\"\n    rel = _relative_text(rel, native)\n    if directory and not rel:\n        return ArticlePath(\"ok\", Path(wiki_root))  # 起点そのもののリンクは許す\n    parts = rel.split(\"/\")\n    # 根の外へ出る名前（絶対パス、ドライブ、..、空の要素）は、記事の名前ではない\n    if rel.startswith(\"/\") or any(part in (\"\", \".\", \"..\") or (NT and \":\" in part) for part in parts):\n        return ArticlePath(\"not_article\")\n    if not is_article_path(rel + \"/article.md\" if directory else rel, native=native):\n        return ArticlePath(\"not_article\")\n    current = os.fspath(wiki_root)\n    st = None\n    for i, part in enumerate(parts):\n        current = os.path.join(current, part)\n        state, st = _stat_entry(current)\n        if state == \"denied\":\n            _notice(\"/\".join(parts[:i + 1]), \"unknown\")\n        if state != \"ok\":\n            return ArticlePath(state)\n        kind = link_kind(st)\n        if kind is not None:\n            _notice(\"/\".join(parts[:i + 1]), kind)\n            return ArticlePath(\"link\", link=(\"/\".join(parts[:i + 1]), kind))\n    if not (stat.S_ISDIR(st.st_mode) if directory else stat.S_ISREG(st.st_mode)):\n        return ArticlePath(\"absent\")\n    return ArticlePath(\"ok\", Path(current))\n\n","numLines":250,"startLine":280,"totalLines":1077}},"tool_result_meta":[{"id":"toolu_012YWU6gHb2jE3418TQvCMKc","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
