+                     f"/{core.FRAME_PREFIX}/{core.FRAME_VERSION}", f"/{core.FRAME_PREFIX}/{core.FRAME_VERSION}/",
+                     self.base + "mermaid-frame.html/x", f"/{core.FRAME_PREFIX}/{core.FRAME_VERSION}/data/search.js"):
