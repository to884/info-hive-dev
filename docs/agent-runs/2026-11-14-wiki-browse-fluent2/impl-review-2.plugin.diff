+  padding: var(--spacingVerticalXXL) var(--spacingHorizontalXXXL) var(--spacingVerticalXXXL);
+}
+/* 記事の本文の大きさと行間は今と同じ 16px と 1.8（土台の 14px と 20px にしない） */
+.page-article #_main { font-size: var(--fontSizeBase400); line-height: 1.8; max-width: 46em; }
