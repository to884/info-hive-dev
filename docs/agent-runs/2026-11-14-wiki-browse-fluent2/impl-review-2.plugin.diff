+@supports (text-autospace: normal) { #_main { text-autospace: normal; } }
+
+/* --- ナビの見出し: スコープ、索引、配色 --- */
+.nav-head { gap: var(--spacingVerticalS); padding-block: var(--spacingVerticalM); }
+.scope { margin: 0; }
+.scope .fui-Badge { white-space: normal; height: auto; }
+.nav-home { font-weight: var(--fontWeightSemibold); }
+.theme-field { display: flex; align-items: center; gap: var(--spacingHorizontalS); }
+.theme-label { font-size: var(--fontSizeBase200); color: var(--colorNeutralForeground3); }
+.theme-field .fui-Select { flex: 1; }
+
+/* --- 検索欄と結果 --- */
+.search { padding: 0 var(--spacingHorizontalM) var(--spacingVerticalS); }
+.search .fui-SearchBox { width: 100%; }
+.search-hint, .fx-hint { margin: var(--spacingVerticalXS) 0 0; color: var(--colorNeutralForeground3); }
+.search-error { color: var(--colorPaletteRedForeground1); }
+.sr-area { padding: 0 var(--spacingHorizontalS); }
+.sr-count, .sr-empty, .sr-incomplete { margin: var(--spacingVerticalXS) var(--spacingHorizontalS); color: var(--colorNeutralForeground3); }
+.sr-link {
+  display: block;
+  padding: var(--spacingVerticalSNudge) var(--spacingHorizontalS);
+  border-radius: var(--borderRadiusMedium);
+  color: var(--colorNeutralForeground1);
+  text-decoration: none;
