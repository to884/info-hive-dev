-}
-body { margin: 0; display: grid; grid-template-columns: 16rem minmax(0, 1fr); }
-#_nav { border-right: 1px solid #d0d7de; padding: 1rem; overflow: auto; max-height: 100vh; position: sticky; top: 0; }
