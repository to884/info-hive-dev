+    chip("すべて", null);
+    types.forEach(function (_n, t) { chip(typeLabel(t), t); });
+
+    // タグの選択。タグは行の span.tag の文字から読み、Map で数える
+    var tagCount = new Map();
+    rows.forEach(function (r) {
