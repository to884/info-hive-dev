+def _largest_candidate(srcset: str) -> str:
+    """srcset の候補から、幅（w）か密度（x）がいちばん大きい URL を返す。記述子がなければ最初の候補。"""
+    best_url, best_size = "", -1.0
+    for candidate in srcset.split(","):
+        fields = candidate.strip().split()
+        if not fields:
+            continue
+        size = 0.0
+        if len(fields) > 1 and fields[-1][-1:] in ("w", "x"):
+            try:
+                size = float(fields[-1][:-1])
+            except ValueError:
+                size = 0.0
+        if size > best_size:
+            best_url, best_size = fields[0], size
+    return best_url
+
+
+def picture_source_url(img: Node) -> str:
+    """<picture> の中の <img> に URL がないとき、兄弟の <source> の srcset から URL を選ぶ。
+
+    Medium などは、URL を <source srcset> にだけ書き、<img> には書かない。WebP でない <source> を
+    先に見る（元の形式の画像を保存するため）。選んだ <source> の中では、いちばん大きい候補を取る。
+    """
+    picture = img.parent
+    if picture is None or picture.tag != "picture":
+        return ""
+    sources = [n for n in picture.children
+               if isinstance(n, Node) and n.tag == "source" and (n.attrs.get("srcset") or n.attrs.get("data-srcset"))]
+    sources.sort(key=lambda n: n.attrs.get("type", "").strip().lower() == "image/webp")
+    for source in sources:
+        url = _largest_candidate(source.attrs.get("srcset") or source.attrs.get("data-srcset") or "")
+        if url and not url.startswith("data:"):
+            return url
+    return ""
+
