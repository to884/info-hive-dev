+    def check_old_images_survive_unfinished_restore(self, replace, expected: type[BaseException]):
+        """本文の置き換えが失敗し、退避した古い画像を戻しきれないとき、古い画像を消さずに退避の場所に残す。"""
+        self.write(self.OLD_TEXT, self.OLD_IMAGES)
