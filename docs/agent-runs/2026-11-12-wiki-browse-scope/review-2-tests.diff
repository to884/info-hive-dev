+# ---------------------------------------------------------------------------
+# wiki のスコープの表示
+# ---------------------------------------------------------------------------
+
+class ScopeTest(TempWiki):
+    """呼び出し元が指定したスコープの確かめ方と、画面への出し方。"""
+
+    def test_make_scope_accepts_and_rejects(self):
+        self.assertIsNone(wiki_browse.make_scope(None, None))
+        self.assertEqual(wiki_browse.make_scope("user", None), {"kind": "user", "name": None})
+        self.assertEqual(wiki_browse.make_scope("project", " info-hive-dev "),
+                         {"kind": "project", "name": "info-hive-dev"})
+        bad = [(None, "x"), ("user", "x"), ("global", None), ("project", "  "), ("project", "a" * 101),
+               ("project", "a\nb"), ("project", "a\x00b"), ("project", "a\u2028b"), ("project", "a\ud800b")]
+        for kind, name in bad:
+            with self.subTest(kind=kind, name=name):
+                with self.assertRaises(ValueError):
+                    wiki_browse.make_scope(kind, name)
+
+    def test_cli_rejects_bad_scope_before_doing_anything(self):
+        write(self.wiki, "a.md", page("# A"))
+        for args in (["--scope-name", "x"], ["--scope", "user", "--scope-name", "x"], ["--scope", "global"]):
+            with self.subTest(args=args):
+                with redirect_stderr(io.StringIO()), self.assertRaises(SystemExit) as cm:
+                    wiki_browse.main(["build", str(self.wiki), *args])
+                self.assertEqual(cm.exception.code, 2)
+        self.assertFalse(self.data.exists())
+
+    def test_label_and_title(self):
+        write(self.wiki, "a.md", page("# A", title="A"))
+        snap = core.take_snapshot(self.wiki)
+        cases = [({"kind": "user", "name": None}, "scope-user", "ユーザースコープの wiki", "A · ユーザースコープ"),
+                 ({"kind": "project", "name": "<p>&x"}, "scope-project", "プロジェクトの wiki", "A · &lt;p&gt;&amp;x"),
+                 ({"kind": "project", "name": None}, "scope-project", "プロジェクトの wiki", "A · プロジェクト")]
+        for scope, cls, heading, title in cases:
+            with self.subTest(scope=scope):
+                c = core.Core(snap, scope=scope)
+                for html in (c.render_page("a"), c.render_index()):
+                    self.assertIn(f'<p id="_scope" class="scope {cls}">{heading}', html)
+                    # スコープの表示は、スクリプトが足すナビゲーションより前（サイドバーの先頭）にある。
+                    self.assertLess(html.index('id="_scope"'), html.index("<noscript>"))
+                    self.assertLess(html.index('<nav id="_nav">'), html.index('id="_scope"'))
+                self.assertIn(f"<title>{title}</title>", c.render_page("a"))
+                if scope["name"]:
+                    self.assertIn('<span class="scope-name">&lt;p&gt;&amp;x</span>', c.render_page("a"))
+                # データのファイル（世代だけで食い違いを確かめる）は、スコープで変わらない。
+                plain = core.Core(snap)
+                for name in core.DATA_FILES:
+                    self.assertEqual(c.render_data(name), plain.render_data(name))
+
+    def test_no_scope_draws_nothing(self):
+        write(self.wiki, "a.md", page("# A", title="A"))
+        for scope in (None, {"kind": "unknown", "name": None}, {}):
+            with self.subTest(scope=scope):
+                c = core.Core(core.take_snapshot(self.wiki), scope=scope)
+                self.assertNotIn('id="_scope"', c.render_page("a"))
+                self.assertIn("<title>A</title>", c.render_page("a"))
+
+    def test_build_shows_given_scope(self):
+        write(self.wiki, "a.md", page("# A"))
+        with redirect_stderr(io.StringIO()):
+            report = wiki_browse.build(self.wiki, None, None, {"kind": "project", "name": "proj"})
+        index = (Path(report["out"]) / "index.html").read_text(encoding="utf-8")
+        self.assertIn('<p id="_scope" class="scope scope-project">プロジェクトの wiki'
+                      '<span class="scope-name">proj</span></p>', index)
+        self.assertEqual(report["leaks"], [])
+        report = self.build()
+        self.assertNotIn('id="_scope"', (Path(report["out"]) / "index.html").read_text(encoding="utf-8"))
+
+    def test_scope_name_with_a_home_path_is_a_warning_not_a_leak(self):
+        write(self.wiki, "a.md", page("# A"))
+        with redirect_stderr(io.StringIO()):
+            report = wiki_browse.build(self.wiki, None, None, {"kind": "project", "name": str(Path.home())})
+        self.assertEqual(report["leaks"], [])
+        self.assertIn("index.html", report["warnings"])
+
+    def test_scope_reads_nothing_outside_the_wiki(self):
+        # スコープを決めるために、wiki の外の作業領域の設定や .git を読まない。
+        write(self.wiki, "a.md", page("# A"))
+        write(self.base / "work", ".info-hive/workspace.json", json.dumps({"version": 1, "kind": "user"}))
+        (self.base / ".git").mkdir()
+        report = self.build()
+        self.assertNotIn('id="_scope"', (Path(report["out"]) / "index.html").read_text(encoding="utf-8"))
+
+    def test_recorded_scope(self):
+        self.assertIsNone(wiki_browse._recorded_scope({}))                       # 前の版のサーバーの記録
+        self.assertIsNone(wiki_browse._recorded_scope({"scope": None}))           # スコープなしで起動した
+        self.assertIsNone(wiki_browse._recorded_scope({"scope": {"kind": "unknown"}}))
+        self.assertIsNone(wiki_browse._recorded_scope({"scope": "user"}))
+        self.assertEqual(wiki_browse._recorded_scope({"scope": {"kind": "project", "name": 3}}),
+                         {"kind": "project", "name": None})
+        self.assertEqual(wiki_browse._recorded_scope({"scope": {"kind": "user", "name": None}}),
+                         {"kind": "user", "name": None})
+
+
 if __name__ == "__main__":
     unittest.main()
