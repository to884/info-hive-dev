+def make_scope(kind: "str | None", name: "str | None") -> "dict | None":
+    """呼び出し元が指定した wiki のスコープを確かめて返す。指定がなければ None（スコープを出さない）。
+
+    スコープは、wiki の場所からは決めない。ユーザースコープかプロジェクトかは、その wiki をどの指示に登録したか
+    （グローバルな指示か、プロジェクトの指示か）で決まり、それを知っているのは wiki を選んだ側（/wiki:browse）
+    である。そのため、このスクリプトはスコープを決めるために wiki の外を読まない。正しくなければ ValueError。
+    """
+    if kind is None:
+        if name is not None:
+            raise ValueError("--scope-name は --scope project と一緒に使う")
+        return None
+    if kind not in core.SCOPE_KINDS:
+        raise ValueError(f"--scope は {' か '.join(core.SCOPE_KINDS)} にする: {kind}")
+    if name is None:
+        return {"kind": kind, "name": None}
+    if kind != "project":
+        raise ValueError("--scope-name は --scope project と一緒に使う")
+    name = name.strip()
+    if not name:
+        raise ValueError("--scope-name が空である")
+    if len(name) > SCOPE_NAME_LIMIT:
+        raise ValueError(f"--scope-name は {SCOPE_NAME_LIMIT} 文字までにする")
+    if any(unicodedata.category(ch) in _SCOPE_NAME_BAD for ch in name):
+        raise ValueError("--scope-name に、制御文字、改行、UTF-8 にできない文字は使えない")
+    return {"kind": kind, "name": name}
+
