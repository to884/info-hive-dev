+def _same_or_inside(path: Path, base: Path) -> bool:
+    """path が base と同じか、base の中にある。Windows では大文字と小文字を区別しない。"""
+    p, b = os.path.normcase(str(path)), os.path.normcase(str(base))
+    try:
+        return os.path.commonpath([p, b]) == b
+    except ValueError:   # ドライブが違う
+        return False
+
+
+def wiki_scope(root: Path, environ: "dict | None" = None, home: "Path | None" = None) -> dict:
+    """wiki がユーザースコープのものか、プロジェクトのものかを、表示のために決める。読むだけで何も書かない。
+
+    次の順に決め、最初に決まったものを返す。返す値は {"kind", "name", "basis"} である。
+    1. wiki のルートから親へさかのぼって作業領域の設定を探し、その dirs.wiki がこの wiki を指せば、設定の
+       kind に従う（basis は workspace）。プロジェクトなら設定の id を名前にする。
+    2. ユーザースコープの作業領域（INFO_HIVE_HOME、なければ ~/info-hive）の中か、以前の既定の ~/wiki なら、
+       ユーザースコープとする（basis は user_home）。
+    3. wiki のルートの親から上のどこかに .git があれば、プロジェクトとし、そのディレクトリの名前を名前にする
+       （basis は git）。wiki のルート自身の .git は見ない。wiki だけを版管理しているのかもしれないからである。
+    4. どれでもなければ unknown とする。
+    作業領域の設定が壊れていても閲覧は止めず、2 以降で決める。
+    """
+    root = Path(root)
+    try:
+        found = workspace.find_workspace(root)
+        wiki_dir = found.dir("wiki") if found is not None else None
+    except (workspace.WorkspaceError, OSError, ValueError):
+        found, wiki_dir = None, None
+    if found is not None and wiki_dir is not None:
+        if os.path.normcase(str(wiki_dir.resolve())) == os.path.normcase(str(root)):
+            name = found.config.get("id") if found.kind == "project" else None
+            return {"kind": found.kind, "name": name.strip() if isinstance(name, str) and name.strip() else None,
+                    "basis": "workspace"}
+    home = Path(home) if home is not None else Path.home()
+    user_root = workspace.user_workspace_root(environ)
+    for base in (user_root, home / "wiki"):
+        try:
+            resolved = Path(os.path.abspath(base)).resolve()
+        except (OSError, RuntimeError):
+            continue
+        if _same_or_inside(root, resolved):
+            return {"kind": "user", "name": None, "basis": "user_home"}
+    for directory in root.parents:
+        try:
+            if (directory / ".git").exists():
+                return {"kind": "project", "name": directory.name or None, "basis": "git"}
+        except OSError:
+            continue
+    return {"kind": "unknown", "name": None, "basis": None}
+
