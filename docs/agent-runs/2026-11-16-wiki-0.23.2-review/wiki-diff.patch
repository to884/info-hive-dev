+# 「raw にない語」を探さない節。取り込みの手順が決めた節で、行き先（create、source_only）やページの名前を並べるので、
+# 本文の語でない文字が目印に混ざる（使い捨ての wiki で試した取り込み、2026-11-16）。
+UNKNOWN_SKIP_HEADINGS = ("主張と行き先", "関係するページ")
+
+
+def _skip_lines(body_lines: list[str]) -> set:
+    """「raw にない語」を探さない節（UNKNOWN_SKIP_HEADINGS の h2 から、次の h1 か h2 の前まで）の行。見出しの行も含む。"""
+    import wiki_pages
+    tokens = wiki_pages.new_parser().parse("\n".join(body_lines))
+    skip: set = set()
+    start = None
+    for i, tok in enumerate(tokens):
+        if tok.type != "heading_open" or not tok.map or tok.level != 0 or tok.tag not in ("h1", "h2"):
+            continue
+        if start is not None:
+            skip.update(range(start, tok.map[0]))
+            start = None
+        inline = tokens[i + 1] if i + 1 < len(tokens) else None
+        if tok.tag == "h2" and inline is not None and inline.content.strip() in UNKNOWN_SKIP_HEADINGS:
+            start = tok.map[0]
+    if start is not None:
+        skip.update(range(start, len(body_lines)))
+    return skip
+
